---
import { Image } from "astro:assets";
import "../styles/global.css";
import { SERVICES } from "../data/services";
import siteMeta from "../data/site-meta.json";
import logo from "../assets{{logo_url}}";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const phone = "{{phone}}";
const phoneHref = phone.replace(/\s/g, "");
const businessName = "{{name}}";
const location = "{{location}}";
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const meta: any = siteMeta;
const geo = meta.geo || null;
const addr = meta.address || null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Locksmith",
  name: businessName,
  telephone: phone,
  url: Astro.site?.href,
  areaServed: location,
  openingHours: "Mo-Su 00:00-24:00",
  ...(geo ? { geo: { "@type": "GeoCoordinates", latitude: geo.lat, longitude: geo.lon } } : {}),
  ...(addr
    ? {
        address: {
          "@type": "PostalAddress",
          ...(addr.street ? { streetAddress: addr.street } : {}),
          ...(addr.city ? { addressLocality: addr.city } : {}),
          ...(addr.postcode ? { postalCode: addr.postcode } : {}),
          addressCountry: "GB",
        },
      }
    : {}),
};

const NAV = [
  { href: "/emergency-locksmith/", label: "Emergency" },
  { href: "/locked-out/", label: "Locked Out" },
  { href: "/lock-changes/", label: "Lock Changes" },
  { href: "/lock-repairs/", label: "Lock Repairs" },
  { href: "/door-repairs/", label: "Door Repairs" },
  { href: "/contact/", label: "Contact" },
];
const currentPath = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:site_name" content={businessName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <!-- Brass top rule -->
    <div class="h-1 bg-brass"></div>

    <!-- Utility strip -->
    <div class="bg-ink text-paper/85 text-[13px]">
      <div class="max-w-page mx-auto px-5 py-2 flex items-center justify-between gap-3 flex-wrap">
        <span>Serving {location} &amp; surrounding areas — 24 hours, 7 days</span>
        <a href={`tel:${phoneHref}`} class="font-semibold text-paper hover:text-brass-pale transition">{phone}</a>
      </div>
    </div>

    <!-- Header -->
    <header class="bg-card border-b border-line sticky top-0 z-40">
      <div class="max-w-page mx-auto px-5 h-[72px] flex items-center justify-between gap-6">
        <a href="/" class="flex items-center gap-3 shrink-0" aria-label={businessName}>
          <Image src={logo} alt={businessName} class="h-11 w-auto" height={44} />
        </a>
        <nav class="hidden lg:flex items-center gap-7 text-[15px]" aria-label="Primary">
          {NAV.map((item) => (
            <a
              href={item.href}
              class={`transition ${currentPath === item.href ? "text-brass-deep font-semibold" : "text-ink/75 hover:text-ink"}`}
            >{item.label}</a>
          ))}
        </nav>
        <a href={`tel:${phoneHref}`} class="btn-primary text-sm !py-2.5 !px-4 whitespace-nowrap">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          {phone}
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Pre-footer CTA -->
    <section class="bg-ink text-paper">
      <div class="max-w-page mx-auto px-5 py-14 text-center">
        <p class="kicker !text-brass-pale mb-3">Need a locksmith now?</p>
        <h2 class="text-3xl md:text-4xl mb-6">Speak to {businessName} today</h2>
        <a href={`tel:${phoneHref}`} class="inline-flex items-center gap-2 bg-brass text-ink font-semibold px-8 py-4 transition hover:bg-brass-pale">
          Call {phone}
        </a>
        <p class="text-paper/60 text-sm mt-4">No call-out fee · Price agreed before work begins</p>
      </div>
    </section>

    <!-- Footer -->
    <footer class="bg-paper border-t border-line text-sm text-stone2">
      <div class="max-w-page mx-auto px-5 py-12 grid grid-cols-1 md:grid-cols-3 gap-10">
        <div>
          <p class="font-display text-lg text-ink mb-3">{businessName}</p>
          <p class="leading-relaxed">Independent local locksmiths covering {location}. DBS-checked engineers, insurance-standard workmanship, available day and night.</p>
        </div>
        <div>
          <p class="font-semibold text-ink mb-3">Services</p>
          <ul class="space-y-1.5">
            {SERVICES.slice(0, 7).map((s) => (
              <li><a href={`/${s.slug}/`} class="hover:text-brass-deep transition">{s.name}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-semibold text-ink mb-3">More</p>
          <ul class="space-y-1.5">
            {SERVICES.slice(7).map((s) => (
              <li><a href={`/${s.slug}/`} class="hover:text-brass-deep transition">{s.name}</a></li>
            ))}
            <li class="pt-2"><a href="/contact/" class="hover:text-brass-deep transition">Contact</a></li>
            <li><a href="/privacy/" class="hover:text-brass-deep transition">Privacy Policy</a></li>
            <li><a href="/cookie/" class="hover:text-brass-deep transition">Cookie Policy</a></li>
          </ul>
        </div>
      </div>
      <div class="hairline">
        <div class="max-w-page mx-auto px-5 py-5 flex items-center justify-between flex-wrap gap-2">
          <span>&copy; {new Date().getFullYear()} {businessName}</span>
          <a href={`tel:${phoneHref}`} class="font-semibold text-ink hover:text-brass-deep transition">{phone}</a>
        </div>
      </div>
    </footer>

    <!-- Mobile sticky call bar -->
    <div class="lg:hidden fixed bottom-0 inset-x-0 z-50 bg-ink p-3">
      <a href={`tel:${phoneHref}`} class="flex items-center justify-center gap-2 bg-brass text-ink font-semibold py-3">
        Call {phone} — 24/7
      </a>
    </div>
    <div class="lg:hidden h-16"></div>
  </body>
</html>
