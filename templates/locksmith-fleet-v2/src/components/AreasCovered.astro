---
interface Props {
  areas: string[];
  postcodes?: string[];
}
const { areas, postcodes = [] } = Astro.props;
const location = "{{location}}";
---
{areas.length > 0 && (
  <section class="bg-card border-y border-line">
    <div class="max-w-page mx-auto px-5 py-12">
      <p class="kicker mb-2">Where we work</p>
      <h2 class="text-2xl md:text-3xl mb-5">Covering {location}</h2>
      <p class="text-stone2 max-w-prose2 mb-6">Our engineers are local, so response times stay short across these neighbourhoods:</p>
      <ul class="flex flex-wrap gap-2">
        {areas.map((a) => (
          <li class="border border-line bg-paper px-3 py-1.5 text-sm text-ink">{a}</li>
        ))}
      </ul>
      {postcodes.length > 0 && (
        <p class="mt-5 text-sm text-stone2">Postcode districts: <span class="text-ink font-medium">{postcodes.join(" · ")}</span></p>
      )}
    </div>
  </section>
)}
