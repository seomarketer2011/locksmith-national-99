---
import Layout from "../layouts/Layout.astro";
const phone = "{{phone}}";
const phoneHref = phone.replace(/\s/g, "");
---
<Layout
  title="Contact {{name}} | Locksmith in {{location}}"
  description="Call {{name}} on {{phone}} for locksmith help across {{location}} — 24 hours a day, 7 days a week."
>
  <section class="max-w-prose2 mx-auto px-5 py-16">
    <p class="kicker mb-3">Contact</p>
    <h1 class="text-4xl mb-6">Get in touch</h1>
    <p class="text-stone2 text-lg leading-relaxed mb-8">
      The fastest way to reach us is by phone — an engineer answers day and night. Tell us
      what's happened and where you are in {{location}}, and we'll give you an honest
      arrival time and a fixed price before any work starts.
    </p>
    <div class="border border-line bg-card p-8 text-center">
      <p class="kicker mb-3">Call any time</p>
      <a href={`tel:${phoneHref}`} class="font-display text-3xl md:text-4xl text-ink hover:text-brass-deep transition">{phone}</a>
      <p class="text-sm text-stone2 mt-4">24/7 · No call-out fee · DBS-checked engineers</p>
    </div>
  </section>
</Layout>
