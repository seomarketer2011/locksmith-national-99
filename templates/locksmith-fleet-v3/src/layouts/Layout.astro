---
import { Image } from "astro:assets";
import "../styles/global.css";
import { SERVICES } from "../data/services";
import siteMeta from "../data/site-meta.json";
import logo from "../assets{{logo_url}}";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const phone = "{{phone}}";
const phoneHref = phone.replace(/\s/g, "");
const businessName = "{{name}}";
const location = "{{location}}";
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const meta: any = siteMeta;
const geo = meta.geo || null;
const addr = meta.address || null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Locksmith",
  name: businessName,
  telephone: phone,
  url: Astro.site?.href,
  areaServed: location,
  openingHours: "Mo-Su 00:00-24:00",
  ...(geo ? { geo: { "@type": "GeoCoordinates", latitude: geo.lat, longitude: geo.lon } } : {}),
  ...(addr ? { address: { "@type": "PostalAddress", ...(addr.street ? { streetAddress: addr.street } : {}), ...(addr.city ? { addressLocality: addr.city } : {}), ...(addr.postcode ? { postalCode: addr.postcode } : {}), addressCountry: "GB" } } : {}),
};

const NAV = [
  { href: "/emergency-locksmith/", label: "Emergency" },
  { href: "/locked-out/", label: "Locked Out" },
  { href: "/lock-changes/", label: "Lock Changes" },
  { href: "/lock-repairs/", label: "Lock Repairs" },
  { href: "/door-repairs/", label: "Door Repairs" },
  { href: "/contact/", label: "Contact" },
];
const currentPath = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/grotesk/SpaceGrotesk-Regular.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/grotesk/SpaceGrotesk-Medium.woff" as="font" type="font/woff" crossorigin />
    <meta property="og:site_name" content={businessName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <!-- Header -->
    <header class="bg-white border-b border-neutral-200 sticky top-0 z-40">
      <div class="max-w-page mx-auto px-4 h-[74px] flex items-center justify-between gap-6">
        <a href="/" class="flex items-center shrink-0" aria-label={businessName}>
          <Image src={logo} alt={businessName} class="h-12 w-auto" height={48} />
        </a>
        <nav class="hidden lg:flex items-center gap-7 text-[15px] font-medium" aria-label="Primary">
          {NAV.map((item) => (
            <a href={item.href} class={`transition ${currentPath === item.href ? "text-amber-600" : "text-neutral-700 hover:text-neutral-900"}`}>{item.label}</a>
          ))}
        </nav>
        <a href={`tel:${phoneHref}`} class="inline-flex items-center gap-2 rounded-xl bg-neutral-900 text-white font-semibold text-sm px-5 py-3 hover:bg-amber-600 transition whitespace-nowrap">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          {phone}
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- CTA band -->
    <section class="bg-neutral-900 text-white">
      <div class="max-w-page mx-auto px-4 py-16 text-center">
        <h2 class="text-3xl md:text-5xl font-bold mb-4">Need a locksmith in {location}?</h2>
        <p class="text-neutral-300 mb-8 text-lg">Speak directly to a local engineer — day or night.</p>
        <a href={`tel:${phoneHref}`} class="inline-flex items-center gap-2 rounded-2xl bg-amber-500 text-neutral-900 font-bold text-lg px-9 py-4 hover:bg-white transition">
          Call {phone}
        </a>
        <p class="text-neutral-400 text-sm mt-5">No call-out fee · Upfront quote before any work</p>
      </div>
    </section>

    <!-- Footer -->
    <footer class="bg-black text-white">
      <div class="max-w-page mx-auto px-6 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
          <div class="text-center md:text-left">
            <h3 class="text-lg font-semibold mb-4">Popular Services</h3>
            <ul class="space-y-2 text-neutral-300">
              {SERVICES.slice(0, 6).map((s) => (
                <li><a href={`/${s.slug}/`} class="hover:text-amber-400 hover:underline transition">{s.name}</a></li>
              ))}
            </ul>
          </div>
          <div class="flex flex-col items-center justify-center order-first md:order-none">
            <Image src={logo} alt={businessName} class="mb-4 h-16 w-auto brightness-0 invert" height={64} />
            <p class="text-sm text-neutral-400">Your local locksmiths for {location}</p>
            <a href={`tel:${phoneHref}`} class="mt-3 font-semibold text-amber-400">{phone}</a>
          </div>
          <div class="w-fit mx-auto md:ml-auto text-center md:text-left">
            <h3 class="text-lg font-semibold mb-4">Opening Hours</h3>
            <p class="font-medium text-neutral-300">Monday – Sunday</p>
            <p class="mb-2 text-neutral-300">24 Hours</p>
            <p class="font-semibold">Emergency call-outs at any hour</p>
          </div>
        </div>
        <div class="border-t border-white/15 mt-10 pt-6 flex items-center justify-center gap-2 text-sm text-neutral-400 flex-wrap">
          <span>&copy; {new Date().getFullYear()} {businessName}</span>
          <span class="mx-1">|</span>
          <a href="/privacy/" class="hover:underline">Privacy Policy</a>
          <span class="mx-1">|</span>
          <a href="/cookie/" class="hover:underline">Cookie Policy</a>
        </div>
      </div>
    </footer>

    <!-- Mobile sticky call bar -->
    <div class="lg:hidden fixed bottom-0 inset-x-0 z-50 bg-neutral-900 p-3">
      <a href={`tel:${phoneHref}`} class="flex items-center justify-center gap-2 rounded-xl bg-amber-500 text-neutral-900 font-bold py-3">
        Call {phone} — open now
      </a>
    </div>
    <div class="lg:hidden h-16"></div>
  </body>
</html>
