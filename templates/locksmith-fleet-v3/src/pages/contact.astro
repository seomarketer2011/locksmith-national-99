---
import Layout from "../layouts/Layout.astro";
const phone = "{{phone}}";
const phoneHref = phone.replace(/\s/g, "");
---
<Layout
  title="Contact {{name}} | Locksmith in {{location}}"
  description="Call {{name}} on {{phone}} for locksmith help across {{location}} — 24 hours a day, 7 days a week."
>
  <section class="max-w-3xl mx-auto px-5 py-16">
    <p class="text-amber-600 font-semibold text-sm uppercase tracking-wide mb-3">Contact</p>
    <h1 class="text-4xl mb-6">Get in touch</h1>
    <p class="text-neutral-600 text-lg leading-relaxed mb-8">
      The fastest way to reach us is by phone — an engineer answers day and night. Tell us
      what's happened and where you are in {{location}}, and we'll give you an honest
      arrival time and a fixed price before any work starts.
    </p>
    <div class="border border-neutral-200 bg-neutral-50 p-8 text-center">
      <p class="text-amber-600 font-semibold text-sm uppercase tracking-wide mb-3">Call any time</p>
      <a href={`tel:${phoneHref}`} class="text-3xl md:text-4xl text-neutral-900 hover:text-amber-600 transition">{phone}</a>
      <p class="text-sm text-neutral-600 mt-4">24/7 · No call-out fee · DBS-checked engineers</p>
    </div>
  </section>
</Layout>
