---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import StaticSections from "../components/StaticSections.astro";
import LocalBlocks from "../components/LocalBlocks.astro";
import { SERVICES } from "../data/services";
import content from "../data/service-content.json";
import enriched from "../data/enriched.json";
import siteMeta from "../data/site-meta.json";
import heroImg from "../assets/services/Lockpicking locksmith.png";

const e: Record<string, any> = enriched as any;
const meta: any = siteMeta;
const sections = ((content as any)["index"] ?? []) as any[];
// First section usually restates the H1; render the rest as body sections.
const bodySections = sections.slice(1);

const title = e["meta.title"] ?? "Locksmith in {{location}} | 24 Hour Call-Out";
const description = e["meta.description"] ?? "Local locksmith covering {{location}} — emergency entry, lock changes and repairs from DBS-checked engineers. No call-out fee.";
const heroParagraph = e["home.hero-paragraph"] ?? "Your local locksmiths for {{location}} — lockouts, lock changes, repairs and security upgrades, handled by DBS-checked engineers.";
const localHeading = e["home.local-context-heading"] ?? "In {{location}}";
const localBody: string | null = e["home.local-context-body"] ?? null;
const localParas = localBody ? localBody.split(/\n\s*\n/).map((p: string) => p.trim()).filter(Boolean) : [];
const faqs = Array.isArray(e["home.local-faqs"]) ? e["home.local-faqs"] : [];
const areas = Array.isArray(e["home.areas-covered"]) ? e["home.areas-covered"] : [];
const postcodes: string[] = Array.isArray(meta.postcode_districts) ? meta.postcode_districts : [];

const phone = "{{phone}}";
const phoneHref = phone.replace(/\s/g, "");
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/services/*.png", { eager: true });
---
<Layout title={title} description={description}>
  <!-- Info pill bar + hero (original pattern) -->
  <section class="w-full bg-white">
    <div class="max-w-page mx-auto px-4 pt-6 pb-14">
      <div class="flex justify-start mb-8">
        <div class="flex flex-wrap items-center gap-y-2 text-sm rounded-full border border-neutral-200 bg-neutral-50 px-6 py-3 text-neutral-700">
          <span class="font-semibold px-3 text-neutral-900">Open now — day or night</span>
          <span class="font-semibold text-amber-500 px-3">{phone}</span>
          <span class="px-3">No call-out fee</span>
          <span class="px-3">Quote agreed before work</span>
          <span class="px-3">DBS-checked engineers</span>
        </div>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-[60%_40%] gap-10 items-center">
        <div>
          <h1 class="text-4xl md:text-5xl font-bold text-neutral-900 leading-tight mb-5">Locksmith in {"{{location}}"}</h1>
          <p class="text-neutral-600 text-lg leading-relaxed mb-8">{heroParagraph}</p>
          <div class="flex flex-wrap gap-3">
            <a href={`tel:${phoneHref}`} class="inline-flex items-center gap-2 rounded-2xl bg-neutral-900 text-white font-bold px-8 py-4 hover:bg-amber-600 transition text-lg">Call {phone}</a>
            <a href="#services" class="inline-flex items-center gap-2 rounded-2xl border border-neutral-300 text-neutral-900 font-semibold px-8 py-4 hover:border-amber-500 transition text-lg">Our services</a>
          </div>
        </div>
        <div class="hidden lg:block">
          <Image src={heroImg} alt="Locksmith at work in {{location}}" class="w-full h-[400px] object-cover rounded-3xl" width={720} />
        </div>
      </div>
    </div>
  </section>

  <!-- Services grid with images (original pattern) -->
  <section id="services" class="bg-neutral-50 py-16 md:py-24">
    <div class="max-w-page mx-auto px-4">
      <h2 class="text-3xl md:text-5xl font-bold text-neutral-900 mb-4">Locksmith services in {"{{location}}"}</h2>
      <p class="text-neutral-600 text-lg mb-10 max-w-3xl">Thirteen specialist services from one local firm — every job priced before it starts.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {SERVICES.map((s) => {
          const img = images[`../assets/services/${s.image}`]?.default;
          return (
            <a href={`/${s.slug}/`} class="group bg-white rounded-3xl overflow-hidden border border-neutral-200 hover:shadow-lg hover:-translate-y-0.5 transition">
              {img && <Image src={img} alt={`${s.name} in {{location}}`} class="w-full h-44 object-cover" width={520} />}
              <div class="p-6">
                <h3 class="text-lg font-bold text-neutral-900 group-hover:text-amber-600 transition mb-1.5">{s.name}</h3>
                <p class="text-sm text-neutral-600 leading-relaxed">{s.short}</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Reworded editorial sections (network-level, tokenised) -->
  <StaticSections sections={bodySections} startIndex={0} />

  <!-- Enriched per-site blocks -->
  <LocalBlocks
    localHeading={localHeading}
    localParas={localParas}
    faqs={faqs}
    areas={areas}
    postcodes={postcodes}
    faqHeading="Frequently asked questions in {{location}}"
  />
</Layout>
