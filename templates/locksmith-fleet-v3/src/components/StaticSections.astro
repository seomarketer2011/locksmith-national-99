---
// Renders the reworded network-level sections (service-content.json) in the
// original fleet's rhythm: alternating white / neutral-50 bands, bold headings.
export type Qa = { q: string; a: string };
export type StaticSection = { heading: string; paras?: string[]; qas?: Qa[] };

interface Props {
  sections: StaticSection[];
  startIndex?: number; // controls band alternation offset
}
const { sections, startIndex = 0 } = Astro.props;
---
{sections.map((s, i) => (
  <section class={`py-16 md:py-20 ${(i + startIndex) % 2 === 0 ? "bg-white" : "bg-neutral-50"}`}>
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 mb-6">{s.heading}</h2>
      {Array.isArray(s.paras) && (
        <div class="space-y-5 text-neutral-600 text-[17px] leading-relaxed">
          {s.paras.map((p) => <p>{p}</p>)}
        </div>
      )}
      {Array.isArray(s.qas) && (
        <div class="space-y-4">
          {s.qas.map((f) => (
            <div class="bg-white border border-neutral-200 rounded-2xl p-6">
              <h3 class="font-semibold text-neutral-900 mb-2">{f.q}</h3>
              <p class="text-neutral-600 leading-relaxed">{f.a}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
))}
