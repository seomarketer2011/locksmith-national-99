---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import hero from "../assets/services/Locked out of house image.png";
import lock from "../assets/services/Locked out of house.png";
import lock2 from "../assets/services/Locked out.png";
import lock3 from "../assets/services/Locked out of house image.png";
import lock4 from "../assets/services/Locked out of house.png";

// Enrichment overlay for service: locked-out
import enriched from "../data/enriched.json";
const e: Record<string, any> = enriched as any;
const slug = "locked-out";
const metaTitle = e[`${slug}.meta.title`] ?? `Locked Out in {{location}}? | Fast, Damage-Minimising Emergency Lockout Service `;
const metaDescription = e[`${slug}.meta.description`] ?? `Emergency lockout service in {{location}}. Lost keys? Locked out? We provide fast, non-destructive entry to get you back inside quickly. 24/7 emergency locksmith service for homes, flats & businesses.`;
const heroParagraph: string | null = e[`${slug}.hero-paragraph`] ?? null;
const localBody: string | null = e[`${slug}.local-context-body`] ?? null;
const localFaqs: { q: string; a: string }[] = Array.isArray(e[`${slug}.local-faqs`]) ? e[`${slug}.local-faqs`] : [];
const localBodyParas = localBody ? localBody.split(/\n\s*\n/).map(p => p.trim()).filter(Boolean) : [];
const areasCovered: string[] = Array.isArray(e[`${slug}.areas-covered`]) ? e[`${slug}.areas-covered`] : [];
import siteMeta from "../data/site-meta.json";
const postcodes: string[] = Array.isArray((siteMeta as any).postcode_districts) ? (siteMeta as any).postcode_districts : [];

---

<MainLayout
  title={metaTitle}
  description={metaDescription}
>
<section class="w-full bg-white">
  <div class="max-w-6xl mx-auto px-4 pt-6 pb-12">
    <!-- Top info bar -->
    <div class="flex justify-left mb-8">
      <div class="flex flex-wrap items-center justify-center gap-y-2 text-sm rounded-full border border-gray-200 bg-gray-50 px-6 py-3 text-gray-700">
        
        <span class="font-semibold px-3 text-gray-900">Call us 24/7</span>
        
        <span class="font-semibold text-amber-500 px-3">
          {{phone}}
        </span>
        
        <span class="px-3">30–60 min response</span>
        
        <span class="px-3">No call-out fee</span>
        
        <span class="px-3">Back inside fast</span>
        
      </div>
    </div>

    <!-- Main content -->
        <div class="grid grid-cols-1 lg:grid-cols-[65%_35%] gap-10 items-start">
      <div>
        <h1 class="text-4xl font-bold text-gray-900 leading-tight">
          Locked Out in {{location}}
        </h1>

        <p class="mt-4 text-gray-600 text-base">
          {heroParagraph || `24/7 Lockout Help in {{location}} • Non-Destructive Entry First • Keep Locks Working Where Possible •
          DBS Checked Technician • Upfront Price Before Work Begins.`}
        </p>

        <!-- Feature cards -->
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="rounded-xl border border-gray-200 p-5">
            <h3 class="font-semibold text-gray-900">
              Fast Access Restored
            </h3>
            <p class="text-sm text-gray-600 mt-1">
              We get you back inside quickly, then check the door and lock still work correctly.
            </p>
          </div>

          <div class="rounded-xl border border-gray-200 p-5">
            <h3 class="font-semibold text-gray-900">
              Non-Destructive Entry
            </h3>
            <p class="text-sm text-gray-600 mt-1">
              We use damage-free methods where possible, protecting uPVC, timber, and composite doors.
            </p>
          </div>

          <div class="rounded-xl border border-gray-200 p-5">
            <h3 class="font-semibold text-gray-900">
              Clear Upfront Pricing
            </h3>
            <p class="text-sm text-gray-600 mt-1">
              You get a confirmed price before we start, with no call-out fee.
            </p>
          </div>

          <div class="rounded-xl border border-gray-200 p-5">
            <h3 class="font-semibold text-gray-900">
              DBS Checked & Insured
            </h3>
            <p class="text-sm text-gray-600 mt-1">
              DBS checked local technician, fully insured, spare cylinders and handles carried if needed.
            </p>
          </div>
        </div>

        <!-- CTA -->
        <a href="tel:{{phone_tel}}" class="mt-10 w-full rounded-xl bg-amber-500 hover:bg-amber-600 transition-colors text-white font-semibold py-4 flex items-center justify-center gap-2">Get Help If Locked Out</a>



      </div>
    </div>
  </div>
</section>
  <!-- Hero Section -->
  <section class="relative bg-neutral-900 text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <Image
        src={hero}
        alt="Emergency lockout service - professional locksmith assistance"
        class="w-full h-full object-cover opacity-30"
        width={1944}
        height={800}
      />
      <div class="absolute inset-0 bg-gradient-to-r from-neutral-900/90 to-amber-500/20"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-24 lg:py-32">
      <div class="max-w-3xl">
        <h2 class="text-4xl md:text-6xl lg:text-7xl font-bold leading-tight">
          Locked Out in <span class="text-amber-400">{{location}}</span>?
        </h2>
        
        <div class="mt-8 space-y-4 text-lg text-neutral-300 leading-relaxed">
          <p>
            Being locked out is stressful, especially when it happens at the worst possible time. If you're locked out in {{location}}, the priority is simple: get you back inside quickly, safely, and with as little disruption as possible. When faced with a locked door, it's important to keep the lock intact whenever possible, using non-destructive entry methods. A professional locksmith focuses on non-destructive entry first, uses the right method for your door and lock type, and gives you a clear idea of ETA and the main price factors before work starts.
          </p>
          <p>
            Lockouts in {{location}} aren't always just "lost keys". It could be a door that's slammed shut, a key left inside, a snapped key, or a uPVC multipoint mechanism that's failed even though you've got the right key. The right approach depends on what's actually happened at the door. That's why a proper locksmith-led lockout service starts with a quick, practical diagnosis—then chooses the safest entry route. Calling a professional, insured locksmith is recommended for safe entry.
          </p>
        </div>
        
        <div class="mt-12 flex flex-col sm:flex-row gap-4">
          <a
            href="tel:{{phone_tel}}"
            class="inline-flex items-center justify-center gap-3 bg-amber-500 text-neutral-900 px-8 py-4 rounded-xl font-bold text-lg hover:bg-amber-400 transition-all duration-300 shadow-lg hover:shadow-amber-500/25 hover:scale-[1.02]"
          >
            <span class="text-xl">🔑</span>
            Emergency Lockout Help
          </a>
         
        </div>
      </div>
    </div>
  </section>

  <!-- Introduction to Lockout Services -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-4xl md:text-5xl font-bold text-neutral-900">
            Emergency Lockout Assistance in {{location}} – What We Help With
          </h2>
          
          <div class="mt-8 space-y-6 text-lg text-neutral-700">
            <p>
              Lockouts come in a few common patterns. The details matter because they affect the best entry method and the likely time on site. Taking proactive measures, such as leaving a spare key with a trusted person, can help prevent future lockouts and save time in emergencies.
            </p>
            <p>
              Lost keys: The most common scenario. If you've lost your keys, first check if a friend, family member, or neighbour has a spare key you can use before calling a locksmith.
            </p>
            <p>
              Broken key in lock: The key snaps off inside the lock, making it impossible to turn or remove.
            </p>
            <p>
              Door slammed shut: Some doors lock automatically when closed, leaving you stranded outside.
            </p>
            <p>
              Malfunctioning lock: Wear and tear or damage can cause locks to jam or fail.
            </p>
            <p>
              For routine lockouts, do not call emergency services, as they only respond to genuine emergencies. Instead, professional locksmiths offer emergency services with quick response times to help you regain access and handle urgent security or repair needs.
            </p>
          </div>
        </div>
        
        <div class="relative">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl">
            <Image
              src={lock}
              alt="Emergency lockout service for lost keys and locked doors"
              class="w-full h-[500px] object-cover"
              width={575}
              height={370}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-amber-900/30 to-transparent"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Common Lockout Scenarios -->
  <section class="bg-neutral-50 py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-neutral-900">
          Common Lockout Scenarios We Handle
        </h2>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Understanding your specific situation helps us choose the right approach for safe entry.
          </p>
        </div>
      </div>
      
      <!-- Lost keys with no spare -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Lost keys with no spare
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            If your keys are genuinely missing, the goal is to regain entry and then decide whether you need to change the lock for security. If keys may be lost nearby, you might choose to keep the lock; if they've been lost in a public place, a lock change is often the safer option.
          </p>
        </div>
      </div>
      
      <!-- Key left inside or "key-in-door" -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Key left inside or "key-in-door"
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            A key left in the internal side of the lock can stop another key from turning outside. In many cases, entry is still possible with a damage-minimising method, depending on cylinder type and door setup.
          </p>
        </div>
      </div>
      
      <!-- Door slammed shut -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Door slammed shut
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            If the latch has engaged and the door isn't deadlocked, entry can sometimes be achieved without replacing any parts. The exact method depends on whether it's a night latch set-up, a standard latch, or a door with additional security features.
          </p>
        </div>
      </div>
      
      <!-- Snapped key in the lock -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Snapped key in the lock
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            A snapped key can leave a fragment in the cylinder that prevents operation. If you have a broken key stuck in the lock, avoid poking at it, as this can cause further damage and make extraction more difficult. The priority is to extract the broken piece where possible, and only replace parts if the cylinder or mechanism is damaged.
          </p>
        </div>
      </div>
      
      <!-- Lock jammed or seized -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Lock jammed or seized
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            If you are locked out in {{location}}, issues with the lock mechanism may be the cause of the problem. If the key won't turn or the lock feels "dead", the issue may be internal wear, misalignment, or a failed mechanism. In these situations, a professional locksmith will assess the lock mechanism to determine if entry can be gained non-destructively, or if a last-resort destructive method is required—followed by replacement and making safe.
          </p>
        </div>
      </div>
      
      <!-- Child or pet locked in -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Child or pet locked in
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            If there's a safety risk, treat it as urgent. Explain the situation clearly when you call so response and method selection reflect the priority and the safest route back inside.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Response Time and Coverage -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-neutral-900">
          Response Time and Coverage Across {{location}}
        </h2>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            For most people locked out, the key question is "How quickly can you get here?" A lockout service should give a realistic ETA for {{location}} based on where the locksmith is coming from and current conditions, not vague promises. Using a local locksmith ensures not only quicker arrival but also familiarity with the local community, which helps deliver more reliable and trusted service.
          </p>
          <p>
            What can affect ETA?
          </p>
          <p>
            Time of day and traffic conditions
          </p>
          <p>
            Whether you're in central {{location}} or surrounding areas
          </p>
          <p>
            Access constraints (gated blocks, communal entrances, restricted parking)
          </p>
          <p>
            A reliable service will also explain what they need from you on arrival, particularly around proof of occupancy.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Non-Destructive Entry -->
  <section class="bg-neutral-50 py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-4xl md:text-5xl font-bold text-neutral-900">
            Non-Destructive Entry Comes First
          </h2>
          
          <div class="mt-8 space-y-6 text-lg text-neutral-700">
            <p>
              Most customers want the same thing: get in without drilling or damage. Non-destructive entry is the default approach whenever the lock and situation allow it. The goal is to keep the lock intact whenever possible, using specialized tools and techniques to preserve the lock's integrity. Professional locksmiths use non-destructive methods to open locks whenever possible. The method used depends on the lock type, security features, and what has actually failed.
            </p>
            <p>
              What "non-destructive" usually means in practice:
            </p>
            <p>
              Techniques designed to open the door without replacing the lock
            </p>
            <p>
              Careful handling of the lock and door to avoid unnecessary damage
            </p>
            <p>
              A clear explanation if the lock's condition or security design makes non-destructive entry unlikely
            </p>
            <p>
              If a lock has failed internally, or the security level is high, our locksmiths will explain why non-destructive entry may not be possible before proceeding.
            </p>
          </div>
        </div>
        
        <div class="relative">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl">
            <Image
              src={lock2}
              alt="Non-destructive lock entry techniques"
              class="w-full h-[500px] object-cover"
              width={575}
              height={370}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-neutral-900/30 to-transparent"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Door and Lock Types -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-neutral-900">
          Door and Lock Types We Commonly Open in {{location}}
        </h2>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Different doors and locks behave differently during a lockout. Locksmiths are experienced in opening locks on various types of doors, including front door locks, high security locks, and window locks.
          </p>
          <p>
            Professional fitting locks is crucial to ensure your door lock provides maximum security and complies with insurance and safety requirements.
          </p>
          <p>
            In addition to lock installation services for various types of locks, locksmiths provide lock repair services to fix faults and extend the life of existing locks, as well as key cutting and domestic locksmith services for residential properties.
          </p>
        </div>
      </div>
      
      <!-- uPVC doors and multipoint locking systems -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          uPVC doors and multipoint locking systems
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            A frequent {{location}} lockout scenario is a multipoint failure: the handle lifts, but the door won't open; or the lock feels like it's turning without retracting anything. These systems can fail due to wear, alignment issues, or a broken gearbox.
          </p>
          <p>
            What matters here is method and aftermath:
          </p>
          <p>
            Entry approach depends on whether the door is fully locked or only partially engaged. For uPVC and multipoint systems, high quality locks are recommended to enhance security and durability.
          </p>
          <p>
            If the mechanism has failed, you may need parts replaced after entry
          </p>
          <p>
            If the door has dropped or misaligned, the underlying issue may need addressing to prevent repeat lockouts
          </p>
        </div>
      </div>
      
      <!-- Euro cylinder locks -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Euro cylinder locks (including anti-snap cylinders)
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Many modern doors use euro cylinders, and some are designed to resist common attacks. That's good for security, but it can affect how straightforward a lockout is. The locksmith should identify the cylinder type and choose the safest method accordingly.
          </p>
        </div>
      </div>
      
      <!-- Night latches and mortice locks -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Night latches and mortice locks
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Night latches (often on older front doors) behave differently depending on whether the internal snib is engaged.
          </p>
          <p>
            Mortice locks may require a different approach depending on whether the door is deadlocked and the condition of the lock case.
          </p>
        </div>
      </div>
      
      <!-- Composite and wooden doors -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Composite and wooden doors
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Composite and timber doors are common across {{location}}. The locksmith should prioritise techniques that avoid damaging the door edge, frame, or lock furniture—especially if the door is well-fitted and security-rated.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- If the Lock Must Be Drilled -->
  <section class="bg-neutral-50 py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-neutral-900">
          If the Lock Must Be Drilled: What Happens Next
        </h2>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Sometimes drilling is the only practical route—typically where:
          </p>
          <p>
            The lock has failed internally and won't respond to non-destructive methods
          </p>
          <p>
            The door is deadlocked and security design prevents safe bypass
          </p>
          <p>
            A damaged cylinder or jammed mechanism makes other options unsafe
          </p>
          <p>
            When drilling is necessary, a competent service will:
          </p>
          <p>
            Explain why it's needed and what will be replaced
          </p>
          <p>
            Drill in a controlled way to regain entry
          </p>
          <p>
            Fit a replacement lock or cylinder on the spot where possible
          </p>
          <p>
            Ensure the door is left secure and functioning properly
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Lock Replacement After Entry -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <h2 class="text-4xl md:text-5xl font-bold text-neutral-900">
            Lock Replacement and Making Safe After Entry
          </h2>
          
          <div class="mt-8 space-y-6 text-lg text-neutral-700">
            <p>
              Not every lockout ends with a lock change—but when keys are missing, stolen, or a mechanism has failed, replacement is often the sensible next step. In these cases, it is crucial to change locks and install a new lock to ensure your property's security, especially after lost or stolen keys. Upgrading to a high security lock or high quality lock can also enhance protection and may be required for insurance compliance. Lock changes can often be completed quickly, sometimes within 30 minutes, depending on the locksmith's availability and location. Our professional locksmiths are equipped to handle both residential and commercial lockout situations.
            </p>
            <p>
              When replacement is commonly recommended:
            </p>
            <p>
              Keys stolen (or likely stolen)
            </p>
            <p>
              Lost keys in a public place with identifiable address/keyring
            </p>
            <p>
              Snapped key that has damaged the cylinder
            </p>
            <p>
              Multipoint failure where parts are worn or broken
            </p>
            <p>
              Making safe and securing the property
            </p>
            <p>
              If parts are required or a full repair can't be completed immediately, the aim is to make the door secure and reduce risk until the final fix is completed. A locksmith should tell you exactly what's been done and what remains.
            </p>
          </div>
        </div>
        
        <div class="relative order-1 lg:order-2">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl">
            <Image
              src={lock3}
              alt="Lock replacement and security upgrades after lockout"
              class="w-full h-[500px] object-cover"
              width={575}
              height={370}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-amber-900/30 to-transparent"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Proof of Occupancy and Authorisation -->
  <section class="bg-neutral-50 py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-neutral-900">
          Proof of Occupancy and Authorisation
        </h2>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Lockout services should take security seriously. Expect to be asked for proof you live there or have authorisation—especially if you've lost your keys and there's no one inside who can confirm access.
          </p>
          <p>
            What counts as proof?
            This can vary, but typically includes:
          </p>
          <p>
            Photo ID with the address
          </p>
          <p>
            A tenancy agreement or utility bill (digital can be acceptable)
          </p>
          <p>
            Confirmation from a landlord/letting agent (where relevant)
          </p>
          <p>
            If you're a tenant, it's also normal for locksmiths to ask about landlord permission depending on the situation and what work is needed after entry.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Price Factors for Lockouts -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-neutral-900">
          Price Factors for Lockouts in {{location}}
        </h2>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Locksmith cost can vary significantly depending on several factors, including the time of day, your location, and the complexity of the lockout situation. For example, emergency call-out prices are often higher during out-of-hours services, and additional costs may apply for materials supplied, delivery, congestion charges, or parking fees. The cost of an emergency locksmith in {{location}} for a lockout service typically starts from £59, with the final price confirmed upon arrival and based on the type of lock and the complexity of the issue.
          </p>
          <p>
            When choosing a locksmith, it's important to look for competitive price options to ensure you get value for money. Many locksmiths in {{location}} offer a 'No Call Out Fee' policy, meaning you only pay for the service provided, while others may have a call out charge depending on the circumstances. Always request transparent pricing estimates upfront to avoid hidden fees or unexpected charges after the service is completed.
