---
import MainLayout from "../layouts/MainLayout.astro";
import hero from "../assets/services/Lock and keys.png"
import { Image } from "astro:assets";

const services = [
  { title: "Emergency Locksmith", slug: "/emergency-locksmith/", desc: "24/7 call-outs for lockouts, failed locks and urgent security problems." },
  { title: "Locked Out", slug: "/locked-out/", desc: "Non-destructive entry to get you back into your home or business fast." },
  { title: "Broken key removal", slug: "/broken-key-removal/", desc: "Snapped key extracted from euro cylinders and mortice locks without damage." },
  { title: "Lock changes", slug: "/lock-changes/", desc: "Same-day lock changes for new homes, lost keys and security upgrades." },
  { title: "Lock repairs", slug: "/lock-repairs/", desc: "Stiff, jammed or failing locks repaired — often cheaper than replacement." },
  { title: "Door lock installation", slug: "/door-lock-installation/", desc: "BS3621 mortice locks, anti-snap cylinders and multipoint systems fitted." },
  { title: "Door lock replacement", slug: "/door-lock-replacement/", desc: "Like-for-like or upgraded replacements for uPVC, composite and timber doors." },
  { title: "Door repairs", slug: "/door-repairs/", desc: "Alignment fixes, handles, hinges and gearboxes for doors that won't lock." },
  { title: "Burglar repair service", slug: "/burglar-repair-service/", desc: "Post-break-in lock changes, door repairs and security upgrades." },
  { title: "Emergency boarding up", slug: "/emergency-boarding-up/", desc: "Same-day boarding for smashed doors and windows to secure your property." },
  { title: "Window lock repair & replacement", slug: "/window-lock-repair-replacement/", desc: "Espagnolette, shootbolt and sash window locks repaired or replaced." },
  { title: "Safe Installation", slug: "/safe-installation/", desc: "Home and business safes supplied, positioned and securely fixed." },
  { title: "Safe Opening", slug: "/safe-opening/", desc: "Lost keys or combinations — safes opened non-destructively where possible." },
];

// Enrichment overlay: per-site AI-generated regions. Falls back to seed copy when key is absent.
import enriched from "../data/enriched.json";
const e: Record<string, any> = enriched as any;
const metaTitle = e["meta.title"] ?? `Locksmith in {{location}}`;
const metaDescription = e["meta.description"] ?? `Trusted local locksmith in {{location}}. Emergency call-outs, lock changes, repairs, and security upgrades for homes and businesses.`;
const heroParagraph = e["home.hero-paragraph"] ?? `24/7 Local Locksmith in {{location}} • Rapid Arrival 30–60 Mins • Damage-Free First • Quote Confirmed Before Work • Parts Carried • DBS Checked, Fully Insured.`;
const localHeading: string | null = e["home.local-context-heading"] ?? null;
const localBody: string | null = e["home.local-context-body"] ?? null;
const localFaqs: { q: string; a: string }[] = Array.isArray(e["home.local-faqs"]) ? e["home.local-faqs"] : [];
const localBodyParas = localBody ? localBody.split(/\n\s*\n/).map(p => p.trim()).filter(Boolean) : [];
const areasCovered: string[] = Array.isArray(e["home.areas-covered"]) ? e["home.areas-covered"] : [];

import siteMeta from "../data/site-meta.json";
const postcodes: string[] = Array.isArray((siteMeta as any).postcode_districts) ? (siteMeta as any).postcode_districts : [];

const seedFaqs = [
  { q: "How fast can you get to me in {{location}}?", a: "We'll give an accurate ETA when you call, based on demand and travel time in {{location}}. Most emergency call-outs are reached within 30–60 minutes." },
  { q: "Can you open my door without breaking the lock?", a: "Often, yes—depending on the lock type and how it's secured. We always aim for non-destructive entry first, and repair or replace only what's needed." },
  { q: "Do I need to prove I live there?", a: "For security, we may ask for ID or proof of occupancy—especially for lock changes. If you're locked out, we'll explain your options on arrival." },
  { q: "Should I change locks after moving house?", a: "It's strongly recommended. You can't be sure who still has copies of old keys." },
  { q: "Do you repair uPVC multipoint locks?", a: "Yes—these are common call-outs. We'll diagnose whether it's alignment, cylinder, or mechanism-related and fix the most cost-effective solution." },
  { q: "Do you charge a call-out fee?", a: "No. We don't charge a call-out fee for emergency services—you only pay for the work performed, with the price confirmed before we start." },
];
const allFaqs = [...seedFaqs, ...localFaqs];
---

<MainLayout
  title={metaTitle}
  description={metaDescription}
>
  <!-- ===== Hero ===== -->
  <section class="bg-[#0e2238] text-white">
    <div class="max-w-6xl mx-auto px-5 pt-14 pb-16 lg:pt-20 lg:pb-24">
      <div class="grid grid-cols-1 lg:grid-cols-[58%_38%] gap-10 items-center">
        <div>
          <p class="text-amber-400 font-semibold tracking-wide uppercase text-sm">{{name}}</p>
          <h1 class="mt-3 text-4xl md:text-5xl font-extrabold leading-tight">
            {{location}}&rsquo;s 24/7 emergency locksmiths
          </h1>
          <p class="mt-5 text-lg text-slate-300 leading-relaxed">
            {heroParagraph}
          </p>

          <!-- Trust badges -->
          <ul class="mt-7 grid grid-cols-2 gap-x-6 gap-y-3 text-[15px] max-w-lg">
            <li class="flex items-center gap-2"><svg class="w-5 h-5 text-amber-400 shrink-0"><use href="#icon-check" /></svg>24/7 emergency cover</li>
            <li class="flex items-center gap-2"><svg class="w-5 h-5 text-amber-400 shrink-0"><use href="#icon-check" /></svg>30–60 min response</li>
            <li class="flex items-center gap-2"><svg class="w-5 h-5 text-amber-400 shrink-0"><use href="#icon-check" /></svg>No call-out fee</li>
            <li class="flex items-center gap-2"><svg class="w-5 h-5 text-amber-400 shrink-0"><use href="#icon-check" /></svg>DBS checked &amp; insured</li>
          </ul>

          <div class="mt-9">
            <a href="tel:{{phone_tel}}"
               class="inline-flex items-center justify-center gap-3 bg-amber-400 text-[#0e2238] px-9 py-4 rounded-lg font-bold text-xl hover:bg-amber-300 transition-colors shadow-lg shadow-amber-500/20">
              📞 {{phone}}
            </a>
            <p class="mt-3 text-sm text-slate-400">Tap to call — open 24 hours, 7 days a week.</p>
          </div>
        </div>

        <div class="hidden lg:block">
          <div class="rounded-2xl overflow-hidden ring-1 ring-white/10 shadow-2xl">
            <Image src={hero} alt={`Locksmith tools and keys — {{name}}`} width={760} height={560}
                   loading="eager" fetchpriority="high" class="w-full h-[420px] object-cover" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 3-step process ===== -->
  <section class="bg-white border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-5 py-16">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 text-center">Help in three simple steps</h2>
      <div class="mt-10 grid md:grid-cols-3 gap-6">
        <div class="rounded-xl border border-slate-200 p-6">
          <div class="w-10 h-10 rounded-full bg-[#0e2238] text-amber-400 flex items-center justify-center font-bold text-lg">1</div>
          <h3 class="mt-4 font-semibold text-slate-900 text-lg">Call us</h3>
          <p class="mt-2 text-slate-600">Tell us what's happened and where you are in {{location}}. We'll give you an ETA and explain the likely solutions there and then.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-6">
          <div class="w-10 h-10 rounded-full bg-[#0e2238] text-amber-400 flex items-center justify-center font-bold text-lg">2</div>
          <h3 class="mt-4 font-semibold text-slate-900 text-lg">We come to you</h3>
          <p class="mt-2 text-slate-600">Our locksmith arrives carrying tools and parts, presents photo ID, then assesses the lock and door and confirms your options.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-6">
          <div class="w-10 h-10 rounded-full bg-[#0e2238] text-amber-400 flex items-center justify-center font-bold text-lg">3</div>
          <h3 class="mt-4 font-semibold text-slate-900 text-lg">Fixed price, job done</h3>
          <p class="mt-2 text-slate-600">You get a clear breakdown of charges before work starts. We complete the job, test everything thoroughly and leave aftercare advice.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Feature boxes ===== -->
  <section class="bg-slate-50">
    <div class="max-w-6xl mx-auto px-5 py-16">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white rounded-xl border border-slate-200 p-6">
          <h3 class="font-semibold text-slate-900">Fast 24/7 response</h3>
          <p class="mt-2 text-sm text-slate-600">Emergency help for lockouts, failed locks, and urgent security issues across {{location}} — day or night.</p>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-6">
          <h3 class="font-semibold text-slate-900">Damage-free entry first</h3>
          <p class="mt-2 text-sm text-slate-600">Non-destructive entry techniques first; we repair or replace only what's needed to restore safe access.</p>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-6">
          <h3 class="font-semibold text-slate-900">Clear upfront pricing</h3>
          <p class="mt-2 text-sm text-slate-600">Your price is confirmed before work begins, with options explained and no call-out fee.</p>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-6">
          <h3 class="font-semibold text-slate-900">DBS checked &amp; insured</h3>
          <p class="mt-2 text-sm text-slate-600">A trusted local technician with parts carried, clean workmanship, and all work guaranteed.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Local narrative ===== -->
  <section class="bg-white">
    <div class="max-w-3xl mx-auto px-5 py-16">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900">Your local locksmith in {{location}}</h2>
      <div class="mt-6 space-y-4 text-lg text-slate-700 leading-relaxed">
        <p>
          Locked out? Key snapped? Need your locks changed today? {{name}} is a trusted locksmith company providing a fast, professional locksmith service in {{location}} for homes and businesses — from emergency call-outs to planned lock upgrades, with clear communication and practical advice.
        </p>
        <p>
          Ideal for homes, flats, HMOs, landlords, and letting agents — lockouts, lock changes, and repairs handled quickly and discreetly. We also support shops, offices, and commercial sites needing secure access: repairs, lock replacements, and security upgrades that protect staff, stock, and property.
        </p>
      </div>

      {localHeading && localBodyParas.length > 0 && (
        <div class="mt-10">
          <h3 class="text-2xl font-bold text-slate-900">{localHeading}</h3>
          {localBodyParas.map((p) => (
            <p class="mt-4 text-lg text-slate-700 leading-relaxed">{p}</p>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ===== Services ===== -->
  <section class="bg-slate-50 border-y border-slate-100">
    <div class="max-w-6xl mx-auto px-5 py-16">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 text-center">Locksmith services in {{location}}</h2>
      <p class="mt-4 text-lg text-slate-600 text-center max-w-2xl mx-auto">We can help with most residential and commercial lock issues, including:</p>
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {services.map((s) => (
          <a href={s.slug} class="group bg-white rounded-xl border border-slate-200 p-6 hover:border-amber-400 hover:shadow-md transition-all">
            <h3 class="font-semibold text-slate-900 text-lg group-hover:text-[#0e2238]">{s.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{s.desc}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-amber-600 group-hover:underline">Learn more →</span>
          </a>
        ))}
      </div>
      <p class="mt-10 text-center text-slate-600 max-w-2xl mx-auto">
        If you're not sure what you need, tell us what's happening and we'll advise the quickest fix.
      </p>
    </div>
  </section>

  <!-- ===== When to call ===== -->
  <section class="bg-white">
    <div class="max-w-3xl mx-auto px-5 py-16">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900">When you should call a locksmith</h2>
      <ul class="mt-8 space-y-3 text-lg text-slate-700">
        <li class="flex gap-3"><svg class="w-6 h-6 text-amber-500 shrink-0 mt-0.5"><use href="#icon-check" /></svg>You're locked out of your property</li>
        <li class="flex gap-3"><svg class="w-6 h-6 text-amber-500 shrink-0 mt-0.5"><use href="#icon-check" /></svg>Your key is stuck, snapped, or spinning</li>
        <li class="flex gap-3"><svg class="w-6 h-6 text-amber-500 shrink-0 mt-0.5"><use href="#icon-check" /></svg>Your lock is jammed, stiff, or not latching properly</li>
        <li class="flex gap-3"><svg class="w-6 h-6 text-amber-500 shrink-0 mt-0.5"><use href="#icon-check" /></svg>You've had a break-in or attempted burglary</li>
        <li class="flex gap-3"><svg class="w-6 h-6 text-amber-500 shrink-0 mt-0.5"><use href="#icon-check" /></svg>You've lost your keys, or your keys may be compromised</li>
        <li class="flex gap-3"><svg class="w-6 h-6 text-amber-500 shrink-0 mt-0.5"><use href="#icon-check" /></svg>You're moving in and want same-day lock changes</li>
        <li class="flex gap-3"><svg class="w-6 h-6 text-amber-500 shrink-0 mt-0.5"><use href="#icon-check" /></svg>A uPVC door won't lock or unlock (often a multipoint issue)</li>
      </ul>
      <p class="mt-8 text-slate-600">If there's an immediate safety risk, contact emergency services first.</p>
    </div>
  </section>

  <!-- ===== Cost factors ===== -->
  <section class="bg-slate-50 border-y border-slate-100">
    <div class="max-w-3xl mx-auto px-5 py-16">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900">What affects the cost of a locksmith in {{location}}?</h2>
      <p class="mt-4 text-lg text-slate-600">Costs vary depending on:</p>
      <ul class="mt-6 space-y-3 text-lg text-slate-700 list-disc marker:text-amber-500 pl-6">
        <li>Time of day (day vs night/weekend)</li>
        <li>Type of lock and door (e.g., uPVC multipoint vs standard cylinder)</li>
        <li>Whether parts are required (cylinder, gearbox, handle set, etc.)</li>
        <li>Complexity and time needed for safe entry or repair</li>
        <li>Commercial vs residential access requirements</li>
      </ul>
      <div class="mt-8 rounded-xl bg-[#0e2238] text-white p-6">
        <p class="font-medium">If you describe the issue, we can usually give a clear estimate range before dispatch — and the final price is confirmed before any work begins.</p>
      </div>
    </div>
  </section>

  <!-- ===== Trust ===== -->
  <section class="bg-white">
    <div class="max-w-3xl mx-auto px-5 py-16">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900">Why {{location}} trusts {{name}}</h2>
      <div class="mt-6 space-y-4 text-lg text-slate-700 leading-relaxed">
        <p>
          Expert knowledge and ongoing training are the foundation of our locksmith service. Our locksmiths are trained to the highest standards and are proud members of the Master Locksmiths Association — with rigorous training and regular assessments covering lock picking, safe opening, and non-destructive entry methods.
        </p>
        <p>
          Every technician is DBS-checked and fully insured, with a repair-first mindset: we replace only when needed and give security-focused advice to prevent repeat issues. We provide 24-hour emergency cover with no call-out fee across {{location}} and the surrounding areas.
        </p>
      </div>
      <div class="mt-8 grid sm:grid-cols-2 gap-4">
        <div class="rounded-xl border border-slate-200 p-5 flex items-center gap-4"><span class="text-2xl">⏰</span><p class="font-medium text-slate-900">24/7 availability for urgent call-outs</p></div>
        <div class="rounded-xl border border-slate-200 p-5 flex items-center gap-4"><span class="text-2xl">📍</span><p class="font-medium text-slate-900">Local coverage across {{location}}</p></div>
        <div class="rounded-xl border border-slate-200 p-5 flex items-center gap-4"><span class="text-2xl">🔧</span><p class="font-medium text-slate-900">Repair-first mindset — replace only when needed</p></div>
        <div class="rounded-xl border border-slate-200 p-5 flex items-center gap-4"><span class="text-2xl">🛡️</span><p class="font-medium text-slate-900">Security advice to prevent repeat issues</p></div>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="bg-slate-50 border-y border-slate-100">
    <div class="max-w-3xl mx-auto px-5 py-16">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900">Frequently asked questions</h2>
      <div class="mt-8 space-y-3">
        {allFaqs.map((f) => (
          <details class="group bg-white rounded-xl border border-slate-200">
            <summary class="cursor-pointer list-none flex items-center justify-between gap-4 p-5 font-semibold text-slate-900">
              {f.q}
              <span class="text-amber-500 text-xl leading-none transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="px-5 pb-5 text-slate-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Coverage ===== -->
  {areasCovered.length > 0 && (
    <section class="bg-white">
      <div class="max-w-6xl mx-auto px-5 py-16">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 text-center">Areas we cover in {{location}}</h2>
        {postcodes.length > 0 && (
          <p class="mt-4 text-center text-lg text-slate-700"><strong>Postcode districts:</strong> {postcodes.join(" · ")}</p>
        )}
        <p class="mt-2 text-center text-slate-600 text-sm max-w-2xl mx-auto">A locksmith call-out anywhere in {{location}} — these are the named areas we routinely attend.</p>
        <ul class="mt-8 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-x-6 gap-y-2 text-slate-700 text-sm">
          {areasCovered.map((a) => (
            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0"></span>{a}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ===== Final CTA ===== -->
  <section class="bg-[#0e2238] text-white">
    <div class="max-w-3xl mx-auto px-5 py-16 text-center">
      <h2 class="text-3xl md:text-4xl font-bold">Need a locksmith in {{location}} now?</h2>
      <p class="mt-4 text-lg text-slate-300">Emergency or planned — get in touch and we'll help you choose the quickest, safest option.</p>
      <a href="tel:{{phone_tel}}"
         class="mt-8 inline-flex items-center justify-center gap-3 bg-amber-400 text-[#0e2238] px-9 py-4 rounded-lg font-bold text-xl hover:bg-amber-300 transition-colors">
        📞 {{phone}}
      </a>
      <p class="mt-3 text-sm text-slate-400">Open 24 hours, 7 days a week — no call-out fee.</p>
    </div>
  </section>

  <!-- Mobile sticky call bar -->
  <div class="lg:hidden sticky bottom-0 left-0 right-0 z-50">
    <div class="bg-[#0e2238] py-3 px-4 border-t border-white/10">
      <a href="tel:{{phone_tel}}"
         class="w-full bg-amber-400 text-[#0e2238] font-bold py-4 px-6 rounded-lg flex items-center justify-center gap-3">
        <span class="text-lg">Call 24/7 Locksmith in {{location}}</span>
      </a>
    </div>
  </div>
</MainLayout>
