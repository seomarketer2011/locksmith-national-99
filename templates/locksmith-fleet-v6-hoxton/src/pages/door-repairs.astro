---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import hero from "../assets/services/door repair.png";
import lock from "../assets/services/door repairs.png";
import lock2 from "../assets/services/door handle repair.png";
import lock3 from "../assets/services/Upvc Patio door.png";
import lock4 from "../assets/services/door repair.png";

// Enrichment overlay for service: door-repairs
import enriched from "../data/enriched.json";
const e: Record<string, any> = enriched as any;
const slug = "door-repairs";
const metaTitle = e[`${slug}.meta.title`] ?? "Door Repair {{location}} | Fast, Secure Fixes for uPVC, Composite & Timber Doors ";
const metaDescription = e[`${slug}.meta.description`] ?? `Emergency door repairs in {{location}}. Door won't lock, close, or is catching? Fast, professional repair service for uPVC, composite & timber doors. Hinge, lock, & alignment fixes. Same-day & emergency service available.`;
const heroParagraph: string | null = e[`${slug}.hero-paragraph`] ?? null;
const localBody: string | null = e[`${slug}.local-context-body`] ?? null;
const localFaqs: { q: string; a: string }[] = Array.isArray(e[`${slug}.local-faqs`]) ? e[`${slug}.local-faqs`] : [];
const localBodyParas = localBody ? localBody.split(/\n\s*\n/).map(p => p.trim()).filter(Boolean) : [];
const areasCovered: string[] = Array.isArray(e[`${slug}.areas-covered`]) ? e[`${slug}.areas-covered`] : [];
import siteMeta from "../data/site-meta.json";
const postcodes: string[] = Array.isArray((siteMeta as any).postcode_districts) ? (siteMeta as any).postcode_districts : [];

---

<MainLayout
  title={metaTitle},
  description={metaDescription}
>
<section class="w-full bg-white">
  <div class="max-w-6xl mx-auto px-4 pt-6 pb-12">
    <div class="flex justify-left mb-8">
      <div class="flex flex-wrap items-center justify-center gap-y-2 text-sm rounded-full border border-gray-200 bg-gray-50 px-6 py-3 text-gray-700">
        
        <span class="font-semibold px-3">Get a quote today</span>
        
        <span class="font-semibold text-amber-500 px-3">
          {{phone}}
        </span>
        
        <span class="px-3">Transparent pricing</span>
        
        <span class="px-3">Written quote available</span>
        
        <span class="px-3">Door closing correctly</span>
        
      </div>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-[65%_35%] gap-10 items-start">
      <!-- Left content -->
      <div>
    <h1 class="text-4xl font-bold">Door Repairs in {{location}}</h1>
    <p class="mt-4 text-gray-600">
          {heroParagraph || `Transparent Pricing for Door Repairs in {{location}} • Identify the Cause • Repair or Replace as Needed • Written Quote Available • Neat Workmanship Throughout.`}
        </p>

    <div class="mt-8 grid sm:grid-cols-2 gap-4">
      <div class="border rounded-xl p-5">Repair doors that stick, drop, or don’t close properly.</div>
      <div class="border rounded-xl p-5">Correct hinges, frames, and keeps for proper sealing.</div>
      <div class="border rounded-xl p-5">Transparent pricing with written quote after inspection.</div>
      <div class="border rounded-xl p-5">Neat workmanship with advice to prevent future movement.</div>
    </div>
    <a href="tel:{{phone_tel}}" class="mt-10 w-full rounded-xl bg-amber-500 hover:bg-amber-600 transition-colors text-white font-semibold py-4 flex items-center justify-center gap-2">Get Help With Door Repairs</a>
  </div>
</div>
</div>
</section>

  <!-- Hero Section -->
  <section class="relative bg-neutral-900 text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <Image
        src={hero}
        alt="Professional door repair service for uPVC, composite, and timber doors"
        class="w-full h-full object-cover opacity-30"
        width={1944}
        height={800}
      />
      <div class="absolute inset-0 bg-gradient-to-r from-neutral-900/90 to-amber-500/20"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-24 lg:py-32">
      <div class="max-w-3xl">
        <h2 class="text-4xl md:text-6xl lg:text-7xl font-bold leading-tight">
          Door Repair in <span class="text-amber-400">{{location}}</span>
        </h2>
        
        <div class="mt-8 space-y-4 text-lg text-neutral-300 leading-relaxed">
          <p>
            A door that won’t lock, won’t close properly, or suddenly starts catching can turn into a security risk fast. In many cases, the problem isn’t the whole door — it’s alignment, a worn hinge, a failed euro cylinder, or a multipoint mechanism that’s started to bind. The right repair restores smooth closing, reliable locking, and a proper seal, without pushing you into an unnecessary replacement. For readers seeking guidance, expert advice is available to help you understand the best solutions for your door repair needs.
          </p>
          <p>
            This Door Repairs service for {{location}} focuses on the faults that cause most call-outs: doors that won’t lock, doors that won’t close, stiff keys, dropped uPVC doors, broken handles and spindles, and multipoint locks that won’t engage. Repairs typically include adjustment and realignment, hinge work, handle and lock replacement, frame and threshold fixes, and draught-proofing (seals, gaskets, and weathering). Where there’s been a break-in attempt or the door won’t secure at all, the priority is making the property safe and restoring a dependable lock-up. Dedicated support is provided to all customers, including commercial and multi-site clients, ensuring tailored solutions for restaurants, offices, hotels, and more.
          </p>
          <p>
            You’ll also get straightforward guidance on repair vs replacement, realistic timescales, and the main price factors (door type, parts required, urgency, and the severity of the fault). When parts are needed — such as a multipoint strip or a specific gearbox — the approach is to diagnose accurately first, then fit the right component, and finish with proper testing: close, latch, lock, and seal. All repairs are guaranteed for your peace of mind, and the efficient, streamlined process ensures minimal disruption. The service offers great value, combining affordability with high-quality workmanship, and repairing your door can help you save money by avoiding unnecessary replacements.
          </p>
        </div>
        
        <div class="mt-12 flex flex-col sm:flex-row gap-4">
          <a
            href="tel:{{phone_tel}}"
            class="inline-flex items-center justify-center gap-3 bg-amber-500 text-neutral-900 px-8 py-4 rounded-xl font-bold text-lg hover:bg-amber-400 transition-all duration-300 shadow-lg hover:shadow-amber-500/25 hover:scale-[1.02]"
          >
            <span class="text-xl">🚪</span>
            Call for Emergency Door Repair
          </a>
     
        </div>
      </div>
    </div>
  </section>

  <!-- Emergency Door Repairs -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-4xl md:text-5xl font-bold text-neutral-900">
            Emergency door repairs in <span class="text-amber-500">{{location}}</span> when the door won’t secure
          </h2>
          
          <div class="mt-8 space-y-6 text-lg text-neutral-700">
            <p>
              When a door won’t lock, you don’t just have an inconvenience — you have an immediate vulnerability. Emergency door repairs prioritise restoring security and safe access, whether the problem is a failed lock, a dropped door, or damage after a break-in attempt. Our efficient response ensures that customers facing urgent security issues receive prompt and reliable support from our skilled team of professionals. You can schedule an emergency appointment for immediate assistance, so your property is secure as quickly as possible.
            </p>
            <p>
              A proper emergency response is less about rushing and more about being decisive: identify whether the fault is alignment, a failed euro cylinder, a jammed multipoint mechanism, or frame movement, then apply the fix that actually restores dependable locking (not a temporary “it sort of works” outcome).
            </p>
          </div>
        </div>
        
        <div class="relative">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl">
            <Image
              src={lock}
              alt="Emergency door repair service for doors that won't lock"
              class="w-full h-[500px] object-cover"
              width={575}
              height={370}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-amber-900/30 to-transparent"></div>
          </div>
        </div>
      </div>
      
      <!-- Common emergency scenarios -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Common emergency scenarios
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            The task of resolving these emergency scenarios is handled by experienced professionals:
          </p>
        </div>
        
        <div class="mt-8 max-w-3xl mx-auto">
          <ul class="space-y-4 text-left list-disc marker:text-amber-500 pl-5">
            <li><strong>Door won’t lock at all:</strong> multipoint not engaging, handle travel lost, gearbox failure, or door dropped on the keeps.</li>
            <li><strong>Key snapped in the lock:</strong> extraction and assessment of whether the cylinder should be replaced.</li>
            <li><strong>Lock stiff or seized:</strong> cylinder wear, debris ingress, incorrect alignment, or internal failure.</li>
            <li><strong>Post-burglary damage:</strong> door edge split, keeps torn out, frame cracked, or lock area forced.</li>
          </ul>
        </div>
      </div>
      
      <!-- What “make safe” looks like in practice -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          What “make safe” looks like in practice
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Making safe usually means restoring a reliable lock-up, reinforcing compromised fixings, and ensuring the door closes cleanly and latches without forcing. If full restoration can’t be completed immediately due to parts availability, temporary securing measures can be used while keeping the door functional and secure.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why doors stop locking or closing properly -->
  <section class="bg-neutral-50 py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-neutral-900">
          Why doors stop locking or closing properly
        </h2>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Most “door repair” problems boil down to one of three issues: alignment, hardware failure, or movement in the door/frame. Fixing the symptom without addressing the cause is why doors often fail again shortly after a quick adjustment. Changes by manufacturers can also affect the availability of replacement hardware parts, making it important to source compatible components or seek skilled adjustments.
          </p>
          <p>
            Our advice: carefully observe how your door operates—check for sticking, gaps, or misalignment, and listen for unusual sounds. Identifying the root cause early can save you from more costly repairs or even full replacements down the line.
          </p>
          <p>
            A correct diagnosis looks at how the door behaves through its full swing, where it contacts the frame, how the latch lines up, and whether the lock engages smoothly across all points. Similar alignment and hardware issues can affect windows as well as doors, so it's worth checking both if you notice problems. If you have glazed doors, pay attention to the quality of the glass during repairs, as high-quality glass improves durability and insulation. For enhanced security and energy efficiency, consider double glazing, which also helps with insulation and can reduce heat loss.
          </p>
        </div>
      </div>
      
      <!-- Signs it’s an alignment issue -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Signs it’s an alignment issue (not “just the lock”)
        </h3>
        
        <div class="mt-8 max-w-3xl mx-auto">
          <ul class="space-y-4 text-left list-disc marker:text-amber-500 pl-5">
            <li>The door locks only when you lift the handle hard—this may indicate that replacement parts do not match the existing door components, causing misalignment.</li>
            <li>The latch hits the strike plate or needs a shove to close—ensure any new hardware matches the original to maintain proper alignment.</li>
            <li>You can see uneven gaps around the frame—matching replacement parts to your current setup is crucial for a seamless repair.</li>
            <li>The door catches at the top or bottom corner, especially in cold or wet weather—check that all components match and align correctly to prevent this issue.</li>
          </ul>
        </div>
      </div>
      
      <!-- Signs it’s a component failure -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Signs it’s a component failure
        </h3>
        
        <div class="mt-8 max-w-3xl mx-auto">
          <ul class="space-y-4 text-left list-disc marker:text-amber-500 pl-5">
            <li>Handle feels loose, droops, or won’t return</li>
            <li>You can lift the handle but nothing engages</li>
            <li>The key turns partially, then binds or stops</li>
            <li>The door locks once, then fails intermittently</li>
            <li>Faulty locks causing difficulty in locking or unlocking the door</li>
          </ul>
        </div>
      </div>
      
      <!-- Movement causes that matter in the UK -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Movement causes that matter in the UK
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Seasonal swelling in timber, minor building movement, wear on hinges, and settlement around frames can all change how a door sits. A repair that accounts for this (adjustment plus restoring correct hardware function) is what keeps the fix stable.
          </p>
          <p>
            Addressing movement issues promptly can save on more extensive repairs in the future.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- uPVC Door Repairs -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-4xl md:text-5xl font-bold text-neutral-900">
            uPVC door repairs in <span class="text-amber-500">{{location}}</span> for dropped doors and failing locks
          </h2>
          
          <div class="mt-8 space-y-6 text-lg text-neutral-700">
            <p>
              uPVC doors are among the most common external doors in the UK, and they tend to fail in predictable ways: the door drops, the keeps no longer line up, and the multipoint lock starts to struggle. The result is usually a door that “almost locks” or needs force to close.
            </p>
            <p>
              Our skilled team provides efficient and streamlined uPVC door repair services, ensuring minimal disruption for our customers, whether residential or commercial. We understand that changes by manufacturers can affect the availability and sourcing of replacement parts, so we use our expertise to find the best solutions. A good uPVC repair typically involves realignment and then correcting the hardware that’s been strained by misalignment — not just swapping one part and hoping. All repairs are guaranteed for your peace of mind, and we offer great value without compromising on quality. To get started, simply schedule an appointment for your uPVC door repair and experience our professional service.
            </p>
          </div>
        </div>
        
        <div class="relative">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl">
            <Image
              src={lock2}
              alt="uPVC door repair for dropped doors and failing locks"
              class="w-full h-[500px] object-cover"
              width={575}
              height={370}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-neutral-900/30 to-transparent"></div>
          </div>
        </div>
      </div>
      
      <!-- Dropped uPVC doors and hinge-side issues -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Dropped uPVC doors and hinge-side issues
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Dropped doors often show as catching, scraping, or a latch that won’t meet the keep cleanly. Repairs can include hinge adjustment, hinge replacement where worn—making sure to select replacement hinges that match the original components for a seamless repair—and restoring correct compression so the door seals without being forced.
          </p>
        </div>
      </div>
      
      <!-- Multipoint locking mechanism repair and replacement -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Multipoint locking mechanism repair and replacement
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Multipoint systems can fail at different points: the gearbox, internal springs, latch, hooks, rollers, or the strip itself. It's important to note that different manufacturers produce similar-looking parts, but these may not be interchangeable, so identifying the correct manufacturer is crucial for sourcing compatible replacements. The repair approach is to confirm whether the mechanism is genuinely failed or simply not engaging due to alignment.
          </p>
        </div>
      </div>
      
      <!-- Handles, spindles, and “lost movement” -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Handles, spindles, and “lost movement”
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            If the handle turns but the lock doesn’t engage, the spindle or internal drive can be worn. When replacing the handle set and spindle (or addressing the internal follower), it’s important to match the new handle set to your existing door hardware to ensure compatibility and maintain a seamless appearance. This can restore full engagement and stop the problem returning.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Composite and Timber Door Repairs -->
  <section class="bg-neutral-50 py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-neutral-900">
          Composite and timber door repairs that restore fit, security, and weather protection
        </h2>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Composite and timber doors have different failure patterns to uPVC. Composite doors can suffer from hardware wear and alignment issues, while wooden doors, known for their timeless elegance and durability, often show swelling, warping, or rot that affects fit and closing. Veneer doors are also a stylish and practical option for interiors, combining the natural look of wood with cost-effective and modern finishing options. Laminate and veneer are popular materials in modern door repairs, offering both aesthetic appeal and affordability.
          </p>
          <p>
            The best repairs focus on restoring the door’s working geometry — closing smoothly, latching cleanly, locking reliably, and sealing against draughts and water. Wooden doors deserve professional attention to maintain their beauty, and our skilled team takes pride in delivering high-quality repairs for composite and timber doors. We are dedicated to meeting the needs of customers seeking reliable and expert door repair services.
          </p>
        </div>
      </div>
      
      <!-- Composite door repair -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Composite door repair: alignment plus hardware integrity
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Composite doors are strong, but if hinges or keeps shift, the locking can become stiff or inconsistent. Our composite door repair process is efficient and effective, involving hinge adjustment, keep realignment, handle replacement, and cylinder or multipoint work depending on the locking type.
          </p>
        </div>
      </div>
      
      <!-- Timber door repair -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Timber door repair: swelling, sticking, and frame interaction
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Wooden doors can bind due to moisture changes. These doors deserve professional restoration and expert care to maintain their timeless elegance and durability. A proper repair may involve hinge correction, easing where appropriate, restoring weather bars or seals, and addressing any soft spots or rot in the door edge or frame before it becomes a security issue. For those looking to upgrade or repair, veneer and laminate options can provide an aesthetically appealing and cost-effective solution, offering a sleek and modern finish.
          </p>
        </div>
      </div>
      
      <!-- Restoring a proper seal -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Restoring a proper seal
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            For both composite and timber, sealing matters. Draughts, rattles, and water ingress often come down to tired seals, threshold issues, or a door that’s been pulled out of line by worn fixings. Restoring proper seals not only prevents these issues but also improves insulation and energy efficiency, helping to reduce heating costs and enhance your home's energy performance.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Lock Repairs -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-neutral-900">
          Lock repairs: euro cylinders, multipoint mechanisms, and failed latches
        </h2>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Lock problems are often described as “the key won’t turn” or “it won’t lock”, but the fix depends on whether the fault is in the cylinder, the mechanism, the door alignment, or due to faulty locks.
          </p>
          <p>
            Our skilled team provides efficient and thorough lock repairs by checking alignment first, then repairing or replacing the correct lock component, and finishing with smooth key action and reliable engagement.
          </p>
        </div>
      </div>
      
      <!-- Euro cylinder problems -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Euro cylinder problems (stiff key, key snapping risk, lock failure)
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Euro cylinders can wear internally, become stiff, or fail suddenly. Different manufacturers produce euro cylinders with varying features and compatibility, so it's important to select a replacement that matches your door's requirements. If the key action is rough or inconsistent, replacement is often the best route — especially if there’s a risk of a key snapping. Where appropriate, upgrades to anti-snap cylinders can significantly improve security after a repair.
          </p>
        </div>
      </div>
      
      <!-- Multipoint lock issues -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Multipoint lock issues (uPVC and composite)
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            If the handle travel feels wrong, the mechanism may be failing. In other cases, it’s simply not lining up with the keeps due to a dropped door. Correct repairs separate these two so parts are replaced only when necessary.
          </p>
        </div>
      </div>
      
      <!-- Key snapped in lock -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Key snapped in lock: extraction and next steps
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Key extraction should be followed by checking for cylinder wear or damage. If the cylinder has been compromised, replacement avoids repeat incidents and improves reliability.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Hinges, Handles, and Alignment -->
  <section class="bg-neutral-50 py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-neutral-900">
          Hinges, handles, and alignment adjustments that stop doors catching and scraping
        </h2>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            A surprising amount of “door repair” is hinge and alignment work. If a door has dropped even slightly, it can strain the lock, damage the keeps, and create a cycle of recurring failures.
          </p>
          <p>
            Our skilled team ensures that adjustments are efficient and precise, restoring proper function quickly. We carefully match any replacement parts, such as hinges or handles, to the original components for seamless compatibility and appearance. Quality adjustments aim for an even gap, smooth swing, and a latch that meets the keep without forcing.
          </p>
        </div>
      </div>
      
      <!-- Hinge repair and replacement -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Hinge repair and replacement
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Worn hinges can cause sagging, rubbing, and misalignment. Repairs include tightening or replacing fixings, hinge replacement where worn—making sure to select replacement hinges that match the original design—and setting the door to the correct height and compression.
          </p>
        </div>
      </div>
      
      <!-- Handle replacement and spindle faults -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Handle replacement and spindle faults
        </h3>
        
        <div class="mt-8 space-y-6 text-lg text-neutral-700 text-left">
          <p>
            Loose handles, drooping handles, or handles that spin without engaging are common. When replacing a worn handle set, it is important to match the new handle to the existing door hardware to ensure compatibility and maintain a cohesive look. Correcting spindle length/fit can restore positive engagement and reduce stress on the mechanism.
          </p>
        </div>
      </div>
      
      <!-- Door adjustment: the “keeps don’t line up” problem -->
      <div class="mt-16 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 text-center">
          Door adjustment: the “keeps don’t line up” problem
        </h3>
        
