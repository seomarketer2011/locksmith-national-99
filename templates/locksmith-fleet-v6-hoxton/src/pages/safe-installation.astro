        <div class="space-y-8">
          {localFaqs.map((f) => (
            <div class="text-left">
              <h3 class="text-xl font-bold text-neutral-900">{f.q}</h3>
              <p class="mt-2 text-lg text-neutral-700">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}


  {areasCovered.length > 0 && (
    <section class="py-16 bg-neutral-50 border-t border-neutral-200">
      <div class="max-w-4xl mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-bold text-neutral-900 mb-6 text-center">Areas we cover in {{location}}</h2>
        {postcodes.length > 0 && (
          <p class="text-center text-neutral-700 mb-4 max-w-xl mx-auto text-sm"><strong>Postcode districts:</strong> {postcodes.join(" · ")}</p>
        )}
        <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-6 gap-y-2 text-neutral-700 list-disc marker:text-amber-500 pl-5">
          {areasCovered.map((a) => (
            <li class="text-sm">{a}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

</MainLayout>

