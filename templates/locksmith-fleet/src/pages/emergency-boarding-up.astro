---
import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/ui/Hero.astro";
import { Image } from "astro:assets";
import hero from "../assets/services/emergnecy boarding.png";
import lock from "../assets/services/Emergency boarding up.png";
import lock2 from "../assets/services/emergnecy boarding.png";
import lock3 from "../assets/services/Emergency boarding up.png";
import lock4 from "../assets/services/emergnecy boarding.png";

// Enrichment overlay for service: emergency-boarding-up
import enriched from "../data/enriched.json";
const e: Record<string, any> = enriched as any;
const slug = "emergency-boarding-up";
const metaTitle = e[`${slug}.meta.title`] ?? `Emergency Boarding Up {{location}} | 24/7 Rapid Response `;
const metaDescription = e[`${slug}.meta.description`] ?? `Emergency boarding up in {{location}} after break-ins, vandalism, storm or fire damage. 24/7 rapid response. Secure windows & doors fast. Same-day service. Call now for immediate property security.`;
const heroParagraph: string | null = e[`${slug}.hero-paragraph`] ?? null;
const localBody: string | null = e[`${slug}.local-context-body`] ?? null;
const localFaqs: { q: string; a: string }[] = Array.isArray(e[`${slug}.local-faqs`]) ? e[`${slug}.local-faqs`] : [];
const localBodyParas = localBody ? localBody.split(/\n\s*\n/).map(p => p.trim()).filter(Boolean) : [];
const areasCovered: string[] = Array.isArray(e[`${slug}.areas-covered`]) ? e[`${slug}.areas-covered`] : [];
import siteMeta from "../data/site-meta.json";
const postcodes: string[] = Array.isArray((siteMeta as any).postcode_districts) ? (siteMeta as any).postcode_districts : [];

---

<MainLayout
