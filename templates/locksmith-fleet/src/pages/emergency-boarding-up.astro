  description={metaDescription}
>
<!-- Emergency Boarding Up Hero Section (Tailwind CSS) -->
<Hero
  variant="light"
  titlePre="Emergency Boarding Up in"
  titleHighlight="{{location}}"
  sub={heroParagraph || `24/7 Emergency Boarding Up Across {{location}} • Fast Protection From Weather and Intruders • Neat Workmanship • Fully Insured • Price Confirmed Before We Start.`}
  points={["30–60 min response", "No call-out fee", "Property protected now"]}
/>

<section class="w-full bg-white">
  <div class="max-w-6xl mx-auto px-4 pt-6 pb-12">
    <!-- Top info bar -->
    <!-- Main content -->
        <div class="w-full">
      <div>
        <!-- Feature cards -->
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="rounded-xl border border-gray-200 p-5">
            <h3 class="font-semibold text-gray-900">
              Immediate Door & Window Boarding
            </h3>
            <p class="text-sm text-gray-600 mt-1">
              We board up doors and windows to protect your property until repairs are completed.
            </p>
          </div>

