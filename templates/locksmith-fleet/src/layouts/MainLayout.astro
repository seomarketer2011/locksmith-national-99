---
import Navbar from "../components/ui/Navbar.astro";
import MainHead from "./MainHead.astro";
import logo from "../assets{{logo_url}}";
import "../styles/global.css";
import { Image } from "astro:assets";

const { ...props } = Astro.props;
const address = "{{address}}";

import siteMeta from "../data/site-meta.json";
const footPostcodes: string[] = Array.isArray((siteMeta as any).postcode_districts) ? (siteMeta as any).postcode_districts : [];
const footNeighborhoods: string[] = (Array.isArray((siteMeta as any).neighborhoods) ? (siteMeta as any).neighborhoods : []).slice(0, 10);
const year = new Date().getFullYear();
---

<html lang="en-GB">
  <MainHead {...props} />
  <body class="bg-white font-grotesk">
    <!-- SVG Sprite -->
    <svg xmlns="http://www.w3.org/2000/svg"  style="display:none;">
      <symbol id="icon-check" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
        <path
          fill-rule="evenodd"
          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
          clip-rule="evenodd"
        />
      </symbol>
    </svg>

    <!-- Preload Hero Image -->


    <main>
      <Navbar />

      <!-- Above the fold -->
      <slot name="hero" />

      <!-- Below the fold sections -->
      <div class="content-auto">
        <slot />
      </div>
      

    </main>
    <footer class="bg-black text-white">
      <div class="max-w-7xl mx-auto px-6 py-14">
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-x-8 gap-y-10">

          <!-- Company info -->
          <div class="col-span-2 md:col-span-3 lg:col-span-1">
            <Image
              src={logo}
              alt="{{name}}"
              width={170}
              height={62}
              loading="lazy"
              class="mb-4"
            />
            <p class="font-semibold">{{name}}</p>
            {address && <p class="mt-2 text-sm text-neutral-300">{address}</p>}
            <p class="mt-2 text-sm text-neutral-300">
              <a href="tel:{{phone_tel}}" class="hover:text-amber-400">{{phone}}</a>
            </p>
            <p class="mt-3 text-sm text-neutral-400">Open 24 hours,<br/>Monday to Sunday</p>
          </div>

          <!-- Emergency Locksmiths -->
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-amber-500 mb-4">Emergency Locksmiths</h3>
            <ul class="space-y-2 text-sm text-neutral-300">
              <li><a href="/emergency-locksmith/" class="hover:text-white hover:underline">Emergency Locksmith</a></li>
              <li><a href="/locked-out/" class="hover:text-white hover:underline">Locked Out</a></li>
              <li><a href="/broken-key-removal/" class="hover:text-white hover:underline">Broken Key Removal</a></li>
              <li><a href="/burglar-repair-service/" class="hover:text-white hover:underline">Burglar Repair Service</a></li>
              <li><a href="/emergency-boarding-up/" class="hover:text-white hover:underline">Emergency Boarding Up</a></li>
            </ul>
          </div>

          <!-- Lock Services -->
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-amber-500 mb-4">Lock Services</h3>
            <ul class="space-y-2 text-sm text-neutral-300">
              <li><a href="/lock-changes/" class="hover:text-white hover:underline">Lock Changes</a></li>
              <li><a href="/lock-repairs/" class="hover:text-white hover:underline">Lock Repairs</a></li>
              <li><a href="/door-lock-installation/" class="hover:text-white hover:underline">Door Lock Installation</a></li>
              <li><a href="/door-lock-replacement/" class="hover:text-white hover:underline">Door Lock Replacement</a></li>
              <li><a href="/door-repairs/" class="hover:text-white hover:underline">Door Repairs</a></li>
              <li><a href="/window-lock-repair-replacement/" class="hover:text-white hover:underline">Window Lock Repair</a></li>
            </ul>
          </div>

          <!-- Safes & Help -->
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-amber-500 mb-4">Safes &amp; Help</h3>
            <ul class="space-y-2 text-sm text-neutral-300">
              <li><a href="/safe-installation/" class="hover:text-white hover:underline">Safe Installation</a></li>
              <li><a href="/safe-opening/" class="hover:text-white hover:underline">Safe Opening</a></li>
              <li><a href="/contact/" class="hover:text-white hover:underline">Contact Us</a></li>
            </ul>
          </div>

          <!-- Coverage -->
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-amber-500 mb-4">Coverage Area</h3>
            <p class="text-sm text-neutral-300">Serving {{location}} and the surrounding areas.</p>
            {footPostcodes.length > 0 && (
              <p class="mt-3 text-sm text-neutral-300"><span class="font-semibold text-white">Postcodes:</span> {footPostcodes.join(", ")}</p>
            )}
            {footNeighborhoods.length > 0 && (
              <ul class="mt-3 space-y-1.5 text-sm text-neutral-300">
                {footNeighborhoods.map((n) => (
                  <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-amber-500 shrink-0"></span>{n}</li>
                ))}
              </ul>
            )}
          </div>

        </div>

        <!-- Divider -->
        <div class="border-t border-white/15 mt-12 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-neutral-400">
          <p>© {year} {{name}}. All rights reserved.</p>
          <p>
            <a href="/cookie/" class="hover:text-white hover:underline">Cookie Policy</a>
            <span class="mx-2">|</span>
            <a href="/privacy/" class="hover:text-white hover:underline">Privacy Policy</a>
          </p>
        </div>
      </div>
    </footer> </body>

  <style>
    .content-auto {
      content-visibility: auto;
      contain-intrinsic-size: 800px;
    }
  </style>
</html>