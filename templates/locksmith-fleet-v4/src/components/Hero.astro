---
import { Image } from "astro:assets";
interface Props {
  h1: string;
  intro: string;
  image: ImageMetadata;
  imageAlt: string;
  breadcrumb?: { label: string; href?: string }[];
}
const { h1, intro, image, imageAlt, breadcrumb = [] } = Astro.props;
const phone = "{{phone}}";
const phoneHref = phone.replace(/\s/g, "");
const points = [
  { t: "Available day or night", d: "Emergency cover, 7 days" },
  { t: "Skilled local engineers", d: "DBS-checked and insured" },
  { t: "No call-out charge", d: "Price agreed before we attend" },
];
---
<section class="relative bg-brandblue-dark text-white overflow-hidden">
  <Image src={image} alt={imageAlt} class="absolute inset-0 w-full h-full object-cover opacity-25" width={1600} />
  <div class="absolute inset-0 bg-gradient-to-r from-brandblue-dark via-brandblue-dark/90 to-brandblue-dark/40"></div>
  <div class="relative max-w-page mx-auto px-4 pt-6 pb-14">
    {breadcrumb.length > 0 && (
      <nav class="text-sm text-white/70 mb-8" aria-label="Breadcrumb">
        {breadcrumb.map((b, i) => (
          <>
            {b.href ? <a href={b.href} class="hover:text-white transition">{b.label}</a> : <span class="text-white">{b.label}</span>}
            {i < breadcrumb.length - 1 && <span class="mx-2 text-white/40">/</span>}
          </>
        ))}
      </nav>
    )}
    <div class="max-w-3xl">
      <h1 class="text-4xl md:text-5xl lg:text-[3.4rem] font-semibold leading-tight mb-5">{h1}</h1>
      <p class="text-lg text-white/85 leading-relaxed mb-8">{intro}</p>
      <div class="flex flex-wrap gap-3 mb-10">
        <a href={`tel:${phoneHref}`} class="inline-flex items-center gap-2 rounded-xl bg-signal text-white font-semibold px-8 py-4 hover:bg-signal-dark transition text-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call {phone}
        </a>
        <a href="/contact/" class="inline-flex items-center gap-2 rounded-xl border border-white/30 text-white font-semibold px-8 py-4 hover:bg-white/10 transition text-lg">Request a callback</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {points.map((p) => (
          <div class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0 w-9 h-9 rounded-full bg-signal/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-signal" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
            </span>
            <div>
              <p class="font-semibold leading-tight">{p.t}</p>
              <p class="text-sm text-white/70">{p.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
