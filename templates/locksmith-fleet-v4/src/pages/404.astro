---
import Layout from "../layouts/Layout.astro";
const phone = "{{phone}}";
const phoneHref = phone.replace(/\s/g, "");
---
<Layout
  title="Page not found | {{name}}"
  description="The page you were looking for doesn't exist. Find locksmith services for {{location}} from the homepage."
>
  <section class="max-w-3xl mx-auto px-5 py-24 text-center">
    <p class="text-signal font-semibold text-sm uppercase tracking-wide mb-3">404</p>
    <h1 class="text-4xl mb-5">That page isn't here</h1>
    <p class="text-slate-600 text-lg mb-8">The link may be out of date. Head back to the homepage, or if you need a locksmith right now, just call.</p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a href="/" class="inline-flex items-center gap-2 rounded-2xl border border-slate-300 text-slate-900 font-semibold px-8 py-4 hover:border-brandblue transition">Back to homepage</a>
      <a href={`tel:${phoneHref}`} class="inline-flex items-center gap-2 rounded-2xl bg-brandblue text-white font-bold px-8 py-4 hover:bg-signal-dark transition">Call {phone}</a>
    </div>
  </section>
</Layout>
