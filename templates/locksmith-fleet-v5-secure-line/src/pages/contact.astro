---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import contactHero from "../assets/pics/home_july-slide1psd_1944x.webp";
---

<MainLayout
  title={`Contact Us - {{name}}`}
  description={`Get in touch with {{name}} in {{location}}. Call us 24/7, or email us to book lock changes, repairs and security upgrades.`}
>
  <!-- Hero Section -->
  <section class="relative bg-neutral-900 text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <Image
        src={contactHero}
        alt="Contact {{name}} in {{location}}"
        class="w-full h-full object-cover opacity-30"
        width={1944}
        height={800}
      />
      <div class="absolute inset-0 bg-gradient-to-r from-neutral-900/90 to-amber-500/20"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 py-24 lg:py-32">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold leading-tight">
          Contact <span class="text-amber-400">{{name}}</span>
        </h1>

        <p class="mt-8 text-lg text-neutral-300 leading-relaxed">
          The quickest way to reach us is by phone. You can also email us and we'll get back to you as soon as we can.
        </p>

        <div class="mt-12 flex flex-col sm:flex-row gap-4">
          <a
            href={`tel:{{phone_tel}}`}
            class="inline-flex items-center justify-center gap-3 bg-amber-500 text-neutral-900 px-8 py-4 rounded-xl font-bold text-lg hover:bg-amber-400 transition-all duration-300 shadow-lg hover:shadow-amber-500/25 hover:scale-[1.02]"
          >
            <span class="text-xl">📞</span>
            Call Us 24/7: {{phone}}
          </a>
        </div>

        <p class="mt-4 text-sm text-neutral-400 flex items-center gap-2">
          <span>💳</span>
          All payments accepted — card, cash &amp; bank transfer
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Details Section -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Phone Card -->
        <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-shadow duration-300 border border-neutral-200">
          <div class="w-16 h-16 bg-amber-100 rounded-xl flex items-center justify-center mb-6">
            <span class="text-3xl text-amber-600">📞</span>
          </div>
          <h3 class="text-2xl font-bold text-neutral-900 mb-4">Phone</h3>
          <div class="space-y-3">
            <div>
              <p class="text-neutral-600">Our line is open day and night, including emergency call-outs</p>
              <a href={`tel:{{phone_tel}}`} class="text-xl font-bold text-neutral-900 hover:text-amber-600 transition-colors">
                {{phone}}
              </a>
            </div>
            <div class="pt-4 border-t border-neutral-200">
              <p class="text-neutral-600">Opening Hours:</p>
              <p class="font-medium">Monday - Sunday: 24hrs</p>
              <p class="text-sm text-neutral-500 mt-2">*Open 24 hours, every day of the year</p>
            </div>
          </div>
        </div>

        <!-- Email Card -->
        <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-shadow duration-300 border border-neutral-200">
          <div class="w-16 h-16 bg-amber-100 rounded-xl flex items-center justify-center mb-6">
            <span class="text-3xl text-amber-600">✉️</span>
          </div>
          <h3 class="text-2xl font-bold text-neutral-900 mb-4">Email</h3>
          <div class="space-y-3">
            <p class="text-neutral-600">For general inquiries, quotes, and bookings:</p>
            <a
              href="#"
              data-u="info"
              data-d="{{domain}}"
              class="text-xl font-bold text-neutral-900 hover:text-amber-600 transition-colors break-all"
            >info [at] {{domain}}</a>
            <p class="text-sm text-neutral-500">We aim to reply within one working day.</p>
          </div>
        </div>

        <!-- Service Area Card -->
        <div class="bg-neutral-100 rounded-2xl p-8">
          <div class="w-16 h-16 bg-amber-100 rounded-xl flex items-center justify-center mb-6">
            <span class="text-3xl text-amber-600">📍</span>
          </div>
          <h3 class="text-2xl font-bold text-neutral-900 mb-4">Service Area: {{location}}</h3>
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <span class="text-amber-600">✓</span>
              <span>Full coverage of {{location}}</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-amber-600">✓</span>
              <span>Surrounding areas covered too</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-amber-600">✓</span>
              <span>Free quotes for scheduled work</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl md:text-5xl font-bold text-neutral-900 text-center mb-12">
          Frequently Asked Questions
        </h2>

        <div class="space-y-6">
          <div class="bg-white rounded-2xl p-8 shadow-lg">
            <h3 class="text-xl font-bold text-neutral-900 mb-3">
              What areas do you cover?
            </h3>
            <p class="text-neutral-700">
              We cover all of {{location}} and the surrounding areas. If you're not sure whether we cover your address, give us a call and we'll confirm.
            </p>
          </div>

          <div class="bg-white rounded-2xl p-8 shadow-lg">
            <h3 class="text-xl font-bold text-neutral-900 mb-3">
              Do you provide quotes before starting work?
            </h3>
            <p class="text-neutral-700">
              Yes, we always provide transparent pricing. We'll give you a clear quote over the phone based on your situation, and for scheduled work we can provide free no-obligation quotes.
            </p>
          </div>

          <div class="bg-white rounded-2xl p-8 shadow-lg">
            <h3 class="text-xl font-bold text-neutral-900 mb-3">
              What payment methods do you accept?
            </h3>
            <p class="text-neutral-700">
              We accept all major credit/debit cards, cash, and bank transfers. For commercial clients, we can also arrange invoicing with agreed payment terms.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-24 bg-gradient-to-br from-neutral-900 to-amber-900/30 text-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-4xl md:text-5xl font-bold mb-8">
        Get in Touch Today
      </h2>

      <p class="text-xl text-neutral-300 mb-12 max-w-2xl mx-auto">
        Give {{name}} a call or drop us an email - we're happy to help.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`tel:{{phone_tel}}`}
          class="inline-flex items-center justify-center gap-3 bg-amber-500 text-neutral-900 px-8 py-4 rounded-xl font-bold text-lg hover:bg-amber-400 transition-all duration-300 shadow-lg hover:shadow-amber-500/25 hover:scale-[1.02]"
        >
          <span class="text-xl">📞</span>
          Call {{phone}}
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<script is:inline>
  // Assemble the email address client-side so it never appears in the
  // page source as scrapeable text.
  document.querySelectorAll("[data-u][data-d]").forEach(function (el) {
    var addr = el.getAttribute("data-u") + "@" + el.getAttribute("data-d");
    el.setAttribute("href", "mailto:" + addr);
    el.textContent = addr;
  });
</script>

<style>
  * {
    scroll-behavior: smooth;
  }

  /* Smooth transitions */
  .transition-all {
    transition-property: all;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 300ms;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 10px;
  }

  ::-webkit-scrollbar-track {
    background: #f1f1f1;
  }

  ::-webkit-scrollbar-thumb {
    background: #f59e0b;
    border-radius: 5px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #d97706;
  }
</style>
