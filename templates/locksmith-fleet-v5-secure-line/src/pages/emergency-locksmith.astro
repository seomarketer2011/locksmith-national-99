---
import MainLayout from "../layouts/MainLayout.astro";
import hero from "../assets/services/Lockpicking locksmith.png"
import lock from "../assets/services/Lockpicking tools and lock.png"
import { Image } from "astro:assets";
const services = [
  { title: "Emergency lockouts / gain entry (non-destructive where possible)", time: "45 mins - 1 hr 15 mins" },
  { title: "Immediate lock changes (lost keys, stolen keys, moving in, break-ins)", time: "1 hr" },
  { title: "Lock repairs (stiff, seized, or broken locks)", time: "1 hr 15 mins" },
  { title: "uPVC door lock repairs and multipoint mechanism faults", time: "1 hr - 2 hrs 15 mins" },
  { title: "Snapped key extraction", time: "45 mins" },
  { title: "Post-burglary securing (lock damage, forced entry repairs)", time: "2 hrs" },
  { title: "Door/lock alignment issues causing failures", time: "1 hr" },
  { title: "Burglary repairs: Emergency response to break-ins, repairing and upgrading locks, and securing properties after a burglary.", time: "2 hrs" },
  { title: "Internal doors: Lock repairs, fitting, and upgrades for internal doors in homes and businesses to enhance security and privacy.", time: "1 hr" },
  { title: "Patio doors: Lock repairs, replacements, and security upgrades for patio doors, including addressing lock malfunctions and ensuring proper installation.", time: "1 hr 15 mins" },
  { title: "Safe opening: Emergency access to locked, damaged, or inaccessible safes.", time: "Varies" },
];

// Enrichment overlay for service: emergency-locksmith
import enriched from "../data/enriched.json";
const e: Record<string, any> = enriched as any;
const slug = "emergency-locksmith";
const metaTitle = e[`${slug}.meta.title`] ?? `Emergency Locksmith in {{location}} – 24/7 Urgent Call-Outs `;
const metaDescription = e[`${slug}.meta.description`] ?? `24/7 emergency locksmith in {{location}}. Locked out? Key snapped? Urgent lock repairs and replacements. Fast response, non-destructive entry. Available 24 hours.`;
const heroParagraph: string | null = e[`${slug}.hero-paragraph`] ?? null;
const localBody: string | null = e[`${slug}.local-context-body`] ?? null;
const localFaqs: { q: string; a: string }[] = Array.isArray(e[`${slug}.local-faqs`]) ? e[`${slug}.local-faqs`] : [];
const localBodyParas = localBody ? localBody.split(/\n\s*\n/).map(p => p.trim()).filter(Boolean) : [];
const areasCovered: string[] = Array.isArray(e[`${slug}.areas-covered`]) ? e[`${slug}.areas-covered`] : [];
import siteMeta from "../data/site-meta.json";
const postcodes: string[] = Array.isArray((siteMeta as any).postcode_districts) ? (siteMeta as any).postcode_districts : [];

---

<MainLayout
  title={metaTitle}
  description={metaDescription}
>
<!-- Locked Out Hero Section (Tailwind CSS) -->


<!-- Emergency Locksmith Hero Section (Tailwind CSS) -->
<section class="w-full bg-white">
  <div class="max-w-6xl mx-auto px-4 pt-6 pb-12">
    <!-- Top info bar -->
    <div class="flex justify-left mb-8">
      <div class="flex flex-wrap items-center justify-center gap-y-2 text-sm rounded-full border border-gray-200 bg-gray-50 px-6 py-3 text-gray-700">
        
        <span class="font-semibold px-3 text-gray-900">Call us 24/7</span>
        
        <span class="font-semibold text-amber-500 px-3">
          {{phone}}
        </span>
        
        <span class="px-3">30–60 min response</span>
        
        <span class="px-3">No call-out fee</span>
        
        <span class="px-3">Safe access restored</span>
        
      </div>
    </div>

    <!-- Main content -->
        <div class="grid grid-cols-1 lg:grid-cols-[65%_35%] gap-10 items-start">
      <div>
        <h1 class="text-4xl font-bold text-gray-900 leading-tight">
          Emergency Locksmith in {{location}}
        </h1>

        <p class="mt-4 text-gray-600 text-base">
          {heroParagraph || `24/7 Fast Arrival Across {{location}} • Damage-Free Entry First • DBS Checked Local Technician •
          Fully Insured • Price Confirmed Before Work Starts Today.`}
        </p>

        <!-- Feature cards -->
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="rounded-xl border border-gray-200 p-5">
            <h3 class="font-semibold text-gray-900">
              Restore Access & Security
            </h3>
            <p class="text-sm text-gray-600 mt-1">
              We restore access and secure your property whether you are locked out or need urgent lock work.
            </p>
          </div>

          <div class="rounded-xl border border-gray-200 p-5">
            <h3 class="font-semibold text-gray-900">
              Damage-Free Entry First
            </h3>
            <p class="text-sm text-gray-600 mt-1">
              We attempt non-destructive entry first, then repair or replace locks correctly if needed.
            </p>
          </div>

          <div class="rounded-xl border border-gray-200 p-5">
            <h3 class="font-semibold text-gray-900">
              Upfront Emergency Pricing
            </h3>
            <p class="text-sm text-gray-600 mt-1">
              An upfront quote is provided before work, with no call-out fee for emergencies.
            </p>
          </div>

          <div class="rounded-xl border border-gray-200 p-5">
            <h3 class="font-semibold text-gray-900">
              DBS Checked & Insured
            </h3>
            <p class="text-sm text-gray-600 mt-1">
              DBS checked local technician, fully insured, guaranteed work, common parts carried.
            </p>
          </div>
        </div>

        <!-- CTA -->
        <a href="tel:{{phone_tel}}" class="mt-10 w-full rounded-xl bg-amber-500 hover:bg-amber-600 transition-colors text-white font-semibold py-4 flex items-center justify-center gap-2">Speak to a Locksmith Now</a>
        <p class="mt-3 text-sm text-gray-500 text-center">💳 All payments accepted — card, cash &amp; bank transfer</p>


     
      </div>
    </div>
  </div>
</section>

  <!-- Hero Section -->
  <section class="relative bg-neutral-900 text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <Image 
        src={hero} 
        alt="Emergency locksmith service responding to urgent call"
        class="w-full h-full object-cover opacity-30" width={1200} height={600} loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-r from-neutral-900/90 to-amber-500/20"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-24 lg:py-32">
      <div class="max-w-3xl mx-left text-left">
        <div class="inline-flex items-center gap-2 bg-amber-500/20 backdrop-blur-sm border border-amber-500/30 px-4 py-2 rounded-full mb-6">
          <span class="text-amber-400 animate-pulse">🚨</span>
          <span class="uppercase tracking-widest text-sm font-bold text-amber-300">
            24/7 Emergency Service
          </span>
        </div>
        
        <h2 class="text-4xl md:text-6xl lg:text-7xl font-bold leading-tight">
          Emergency Locksmith in <span class="text-amber-400">{{location}}</span>
        </h2>
        
