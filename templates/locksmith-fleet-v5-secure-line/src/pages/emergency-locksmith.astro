            <p class="text-neutral-800">
              Our locksmiths carry mobile payment tools, such as chip & pin terminals, so you can conveniently pay on site or over the phone.
            </p>
            <p class="mt-4 text-neutral-800 font-medium">
              Our trustworthy locksmiths will provide a clear estimate of costs before starting any work, ensuring transparency.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Emergency locksmith pricing in [location] -->
  <section class="bg-neutral-50 py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-neutral-900">
          Emergency locksmith pricing in {{location}}
        </h2>
        
        <div class="mt-8 text-lg text-neutral-700">
          <p>
            Emergency locksmith cost depends on:
          </p>
        </div>
      </div>
      
      <div class="mt-10 max-w-3xl mx-auto">
