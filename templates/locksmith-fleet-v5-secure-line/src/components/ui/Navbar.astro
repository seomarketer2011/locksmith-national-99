---
import logo from "../../assets{{logo_url}}";

// Per-site header ground: logos marked "black" sit on the brand navy,
// otherwise a white header with ink text. Both stay inside the Secure Line system.
const isDarkHeader = "{{color}}".toLowerCase().includes("black");

const headerBgClass = isDarkHeader ? "bg-navy" : "bg-white";
const headerTextClass = isDarkHeader ? "text-slate-200" : "text-ink";
const headerHoverTextClass = isDarkHeader ? "hover:text-brass-bright" : "hover:text-brass";
const headerRuleClass = isDarkHeader ? "border-white/10" : "border-line";

const dropdownBgClass = isDarkHeader ? "bg-steel border-white/10" : "bg-white border-line";
const dropdownItemClass = isDarkHeader ? "text-slate-200 hover:text-brass-bright hover:bg-white/5" : "text-ink hover:text-brass hover:bg-paper";
const mobileItemHoverClass = isDarkHeader ? "hover:bg-white/5" : "hover:bg-paper";

const dropdownItems = {
  'Emergency Locksmiths': [
    { href: '/broken-key-removal/', label: 'Broken key removal' },
    { href: '/burglar-repair-service/', label: 'Burglar repair service' },
    { href: '/emergency-boarding-up/', label: 'Emergency boarding up' },
    { href: '/emergency-locksmith/', label: 'Emergency Locksmith' },
    { href: '/locked-out/', label: 'Locked Out' },
  ],
  'Lock Services': [
    { href: '/lock-changes/', label: 'Door lock change' },
    { href: '/door-lock-installation/', label: 'Door lock installation' },
    { href: '/lock-repairs/', label: 'Door lock repair' },
    { href: '/door-lock-replacement/', label: 'Door lock replacement' },
    { href: '/door-repairs/', label: 'Door repairs' },
    { href: '/window-lock-repair-replacement/', label: 'Window lock repair & replacement' },
  ],
  'Safes': [
    { href: '/safe-installation/', label: 'Safe Installation' },
    { href: '/safe-opening/', label: 'Safe Opening' },
  ]
};

const menuitems = [
  { href: '/', label: 'Emergency Locksmiths', hasDropdown: true },
  { href: '/', label: 'Lock Services', hasDropdown: true },
  { href: '/', label: 'Safes', hasDropdown: true },
  { href: '/contact/', label: 'Contact', hasDropdown: false },
];
---

<nav class={`w-full top-0 left-0 z-50 sticky ${headerBgClass} border-b ${headerRuleClass} font-body`}>
  <header class="mx-auto flex max-w-6xl flex-row justify-between items-center gap-4 px-5">
    <div class="flex items-center justify-between gap-4 w-full lg:w-auto">
      <a href="/" class="flex items-center">
        <img src={logo.src} alt="{{name}} logo" width={logo.width} height={logo.height} class="navbar-logo" loading="eager" />
      </a>

      <div class="flex items-center gap-2 lg:hidden">
        <a href="tel:{{phone_tel}}" aria-label="Call {{phone}}"
           class="grid h-10 w-10 place-items-center rounded-lg bg-brass text-navy">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6.6 3h3l1.5 4.2-2 1.5a12.5 12.5 0 0 0 5.7 5.7l1.5-2 4.2 1.5v3A1.8 1.8 0 0 1 18.7 19 15.7 15.7 0 0 1 4.5 4.8 1.8 1.8 0 0 1 6.6 3z"/>
          </svg>
        </a>
        <details class="relative group">
          <summary class={`list-none cursor-pointer w-10 h-10 grid place-items-center rounded-lg border ${headerRuleClass}`}>
            <svg class={`open-icon w-6 h-6 ${headerTextClass}`} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg class={`close-icon w-6 h-6 ${headerTextClass}`} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="display: none;">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </summary>

          <div class={`absolute right-0 top-full mt-2 w-72 ${dropdownBgClass} border rounded-xl shadow-xl z-50`}>
            <ul class="font-medium flex flex-col p-3 space-y-1">
              {menuitems.map((item) => (
                <li>
                  {item.hasDropdown ? (
                    <details class="mobile-dropdown">
                      <summary class={`flex justify-between items-center py-2.5 px-3 text-[15px] ${headerTextClass} rounded-lg ${mobileItemHoverClass} transition-colors cursor-pointer`}>
                        <span>{item.label}</span>
                        <svg class="w-4 h-4 transition-transform" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                      </summary>
                      <ul class="ml-3 mt-1 space-y-0.5 border-l border-brass/40 pl-3">
                        {dropdownItems[item.label]?.map((subItem) => (
                          <li>
                            <a href={subItem.href} class={`block py-2 px-3 text-sm rounded-lg ${dropdownItemClass} transition-colors`}>
                              {subItem.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  ) : (
                    <a href={item.href} class={`block py-2.5 px-3 text-[15px] ${headerTextClass} rounded-lg ${mobileItemHoverClass} transition-colors`}>
                      {item.label}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </details>
      </div>
    </div>

    <nav class="hidden lg:flex lg:items-center lg:gap-6">
      <ul class="flex flex-row items-center gap-1">
        {menuitems.map((item) => (
          <li class="relative group">
            {item.hasDropdown ? (
              <>
                <button class={`flex items-center gap-1 py-2 px-3 text-[15px] font-medium ${headerTextClass} ${headerHoverTextClass} transition-colors`}>
                  {item.label}
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                </button>

                <div class={`absolute left-0 top-full mt-1 w-64 ${dropdownBgClass} border rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50`}>
                  <ul class="py-2">
                    {dropdownItems[item.label]?.map((subItem) => (
                      <li>
                        <a href={subItem.href} class={`block py-2.5 px-4 text-sm ${dropdownItemClass} transition-colors`}>
                          {subItem.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            ) : (
              <a href={item.href} class={`block py-2 px-3 text-[15px] font-medium ${headerTextClass} ${headerHoverTextClass} transition-colors`}>
                {item.label}
              </a>
            )}
          </li>
        ))}
      </ul>

      <a href="tel:{{phone_tel}}"
         class="inline-flex items-center gap-2 rounded-xl bg-brass px-4 py-2.5 font-mono text-sm font-medium tracking-wide text-navy transition hover:bg-brass-bright">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6.6 3h3l1.5 4.2-2 1.5a12.5 12.5 0 0 0 5.7 5.7l1.5-2 4.2 1.5v3A1.8 1.8 0 0 1 18.7 19 15.7 15.7 0 0 1 4.5 4.8 1.8 1.8 0 0 1 6.6 3z"/>
        </svg>
        {{phone}}
      </a>
    </nav>
  </header>
</nav>

<style is:inline>
  details > summary { list-style: none; }
  details > summary::-webkit-details-marker { display: none; }
  details[open] .open-icon { display: none; }
  details[open] .close-icon { display: block !important; }

  .mobile-dropdown > summary svg { transition: transform 0.2s ease; }
  .mobile-dropdown[open] > summary svg { transform: rotate(180deg); }

  .absolute { transform-origin: top center; animation: fadeIn 0.2s ease-in-out; }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .navbar-logo {
    height: 64px !important;
    width: auto !important;
    max-height: 64px !important;
    object-fit: contain !important;
    display: block !important;
  }

  nav { height: 80px !important; }
  header { height: 80px !important; }

  @media (max-width: 1024px) {
    .navbar-logo { height: 52px !important; max-height: 52px !important; }
    nav, header { height: 64px !important; }
  }
</style>
